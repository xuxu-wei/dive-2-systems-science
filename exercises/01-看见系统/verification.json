  "p01-internal-transfer": {
    "correct": [
      "A",
      "B",
      "C"
    ],
    "explanations": {
      "A": "B 收到外部流入 2 U，又向 C 转移 3 U，因此 B 的净变化为 2−3=−1 U。",
      "B": "C 从 B 收到 3 U，又向外界排出 1 U，因此 C 的净变化为 3−1=2 U。",
      "C": "把两区的变化相加，得到 −1+2=1 U。把两区合起来作为系统，只计算从外界进入和流向外界的量，也得到 2−1=1 U。",
      "D": "这 3 U 离开 B 后全部进入 C，仍在两区合起来的系统中。B 的账上记 −3，C 的账上记 +3，两本账相加时它们相消；再从总量中扣除就多算了同一次转移。"
    }
  },
