  "p01-rate-amount": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "q 表示每单位时间流入多少，还不是整段累计流入的量。",
      "B": "持续 h 个时间单位，每个时间单位都流入 q，因此整段累计流入为 hq，单位为 T×U/T=U。",
      "C": "q/h 的单位是 U/T²。",
      "D": "U 不能直接加 U/T。"
    }
  },
