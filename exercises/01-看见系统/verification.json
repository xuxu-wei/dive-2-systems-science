  "p01-hidden-production": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "X由Y生成，追踪X时应计入内部生成。",
      "B": "X 是在系统中由 Y 转化而来的，没有从系统外进入，所以不能记作外部流入。",
      "C": "生成发生在观察期间，不能并入起始时刻的总量。",
      "D": "X 与 Y 是不同物质。追踪 X 时，Y 转成 X 会增加 X 的总量；它与同一种物质在两个区域之间转移的情况不同。"
    }
  },
  "p01-conserved-total": {
    "correct": [
      "A",
      "C"
    ],
    "explanations": {
      "A": "两区总量的变化是 −3+3=0 U，所以两区总量之和不变。",
      "B": "物质可以从 B 转入 C，使 B 减少、C 增加而总量不变。因此总量不变不能说明两区之间没有转移。",
      "C": "从 B 向 C 净转移 3 U 可以得到题设变化。起点和终点的记录没有说明过程中各时刻怎样转移。",
      "D": "在题设条件下，C 增加的物质来自系统中的 B；它没有从两区之外进入，不能记作从外界进入的量。"
    }
  },
