{
  "p01-boundary": {
    "correct": [
      "A",
      "C"
    ],
    "explanations": {
      "A": "血液边界外的组织接收了物质，因此这是输出。",
      "B": "转移仍发生在联合边界内部，联合记账时一减一增抵消。",
      "C": "研究量与时间范围决定需要纳入哪些对象和过程。",
      "D": "合并为均匀存量（stock）会丢失两室分配，不能直接回答血液量如何变化。"
    }
  },
  "p01-state-observation": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "同单位不意味着同数值；体表和内部温度可存在系统差异。",
      "B": "参数描述传热关系，与被追踪的内部状态和传感器读数作用不同。",
      "C": "外部输入能够影响系统和读数，边界之外不等于可忽略。",
      "D": "推断需要连接观测、内部状态和环境条件的测量关系。"
    }
  },
