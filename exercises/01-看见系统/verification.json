    "explanations": {
      "A": "U 与 U/L 不能直接相加。",
      "B": "U 与 L 是不同种类的量。",
      "C": "(U/L)×L = U；单位正确还需检查情境是否适用。",
      "D": "单位是 U/L²，不是总量。"
    }
