    ],
    "explanations": {
      "A": "固定阶段权重没有固定终端价值和剩余时长，有限时域增益仍可随时间变化。",
      "B": "终端价值经Riccati倒推进入当前决策，改变边界或步数通常改变增益。",
      "C": "任意有限正时域没有等同于无限时域问题；稳定化解和极限还需相应条件。",
      "D": "更早的输入决定终端状态，因此终端成本可以通过倒推影响此前决策。"
    }
  },
