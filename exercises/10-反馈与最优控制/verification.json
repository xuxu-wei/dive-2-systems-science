  "p10-nyquist-hypotheses": {
    "correct": [
      "A",
      "D"
    ],
    "explanations": {
      "A": "判据将闭环右半平面特征零点数、开环极点数和绕数联系起来，二者需共同计算。",
      "B": "零绕数仍需结合开环右半平面极点数，不能单凭绕数判断稳定。",
      "C": "1+L(s)=0对应 L(s)=−1，所以临界点应是−1。",
      "D": "反转轮廓或改变正负计数会改变绕数符号，判据公式应保持同一约定。"
    }
  },
  "p10-bode-margin": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "增加30°超前会到−120°，增加滞后才会到−180°。",
      "B": "相位裕度是角度，不是相位交叉处的增益倍数。",
      "C": "执行器限幅改变的是非线性输入条件，30°不能换成上限百分比。",
      "D": "从−150°再落后30°到−180°，这就是该交叉点的相位余量。"
    }
  },
  "p10-phase-wrap": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "非零复响应也会跨过主值分支，显示跳变不要求幅值为零。",
      "B": "358°是两次主值显示的差，不能直接当作连续相位的变化。",
      "C": "+179°与−179°并非同一角度，它们仍相差一个小的连续变化。",
      "D": "+179°和−181°相差360°，因此这次显示跳变可以对应连续相位下降2°。"
    }
  },
