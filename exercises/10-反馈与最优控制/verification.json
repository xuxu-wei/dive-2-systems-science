{
  "p10-pi-saturation": {
    "cases": [
      {
        "arguments": {
          "error": 2.0,
          "integral": 0.0,
          "dt": 1.0,
          "kp": 1.0,
          "ki": 1.0,
          "limit": 2.0
        },
        "expected": [
          2.0,
          2.0,
          0.0
        ]
      },
      {
        "arguments": {
          "error": -1.0,
          "integral": 3.0,
          "dt": 0.5,
          "kp": 1.0,
          "ki": 1.0,
          "limit": 2.0
        },
        "expected": [
          1.5,
          1.5,
          2.5
        ]
      },
      {
        "arguments": {
          "error": 0.0,
          "integral": 1.0,
          "dt": 1.0,
          "kp": 2.0,
          "ki": 1.0,
          "limit": 2.0
        },
        "expected": [
          1.0,
          1.0,
          1.0
        ]
      }
    ],
    "explanation": "样例中候选积分为2 U·T、请求为4 U/T。裁剪且误差与请求同号，积分恢复为0；重算请求为2 U/T，实际也为2 U/T，返回[2,2,0]。"
  },
  "p10-pi-constant-load": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "P 需要通过当前误差产生持续输入，因而可能在偏离目标处达到平衡。",
      "B": "PI 的积分在稳态保持不变要求误差为零；题设中的稳定、未饱和条件使抵消恒定扰动的输入可以持续存在。",
      "C": "稳定并未使两种规则相同：P 可能依靠非零误差维持输入，PI 则可以由保存的积分提供输入。",
      "D": "误差定义决定请求符号，对象的输入作用方向决定这个请求是否抵消偏差；两者需一起判断。"
    }
  },
  "p10-request-vs-actuation": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "用8推进相当于让对象接受执行器未提供的输入，尽管记录中的两个数正确。",
      "B": "对象使用了未执行的8，请求与实际输入的记录也被颠倒。",
      "C": "用5推进正确，但请求8和实际5的记录位置应保留原义。",
      "D": "对象使用实际5推进，同时记录请求8和实际5，才可解释执行饱和造成的差异。"
    }
  },
  "p10-gain-units": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "这组单位使比例项和积分项都成为 U，缺少输入所需的1/T。",
      "B": "这组单位使比例项为 U·T、积分项为 U·T³，均不符合输入单位。",
      "C": "比例项为 U/T，但积分项为 U，二者不能按所给输入单位相加。",
      "D": "kp取1/T、ki取1/T²，两个乘积都为 U/T。"
    }
  },
