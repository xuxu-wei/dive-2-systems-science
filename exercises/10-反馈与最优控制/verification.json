  "p10-actuator-position": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "AB₁=[1,0]ᵀ，AB₂=0，所以两者可控矩阵（matrix）秩分别为2、1。",
      "B": "B₂与AB₂分别为[1,0]ᵀ及0，没有第二个独立方向。",
      "C": "把执行器直接驱动位置与经积分传递到位置的作用颠倒。",
      "D": "B₁与AB₁线性独立，不能只看B₁的一列判断二维可控性。"
    }
  },
  "p10-rank-tolerance": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "可逆单位变换不改精确秩，但可改变条件数（condition number）和阈值判定。",
      "B": "物理可控性不因可逆单位变换改变，阈值变化可能是数值尺度效应。",
      "C": "舍入会丢弃小但非零的方向，改变矩阵而非修复尺度问题。",
      "D": "行列式依赖单位和尺度，不能直接当作跨单位的信息质量比较。"
    }
  },
  "p10-controllable-not-feasible": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "1是速度增量；位置增量是加速度积分两次得到0.5。",
      "B": "可控性允许无约束输入，不保证给定时间与幅值限制下可达。",
      "C": "u≤1且初速度0，x₁(1)=∫₀¹(1−t)u(t)dt≤1/2。",
      "D": "本题终端速度不限；负输入会降低位置积分，不能超过持续最大正输入。"
    }
  },
