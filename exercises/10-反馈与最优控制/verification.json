  "p10-derivative-noise": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "相邻噪声差的幅度为0.2 U；除以1 T得到0.2 U/T，除以0.1 T得到2 U/T，放大10倍。",
      "B": "差分除以步长，缩短步长会放大固定噪声差，变化方向与此选项相反。",
      "C": "真实误差没有变化，但读数噪声的相邻差仍存在，而且分母已经缩小。",
      "D": "幅度放大10倍；只有把幅度平方得到相应平方量时才出现100倍。"
    }
  },
  "p10-freeze-direction": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "零误差不会新增积分，冻结规则也没有要求清空旧积分。",
      "B": "负误差使积分项减小，有助于让正向请求回到上限以内，不满足同号冻结条件。",
      "C": "正误差进一步增加正向请求，满足裁剪且乘积为正的条件，应保留旧积分。",
      "D": "实际输入仍在上限不能单独决定冻结；负误差与正候选请求异号，应允许这次反向积分。"
    }
  },
  "p10-pid-comparison": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "各方法面对不同且经挑选的扰动，场景难度会与控制规则差异混在一起。",
      "B": "相同对象、起点、外部序列、执行能力和评价时段，使任务条件对齐。",
      "C": "只给 PID 加噪声和限幅，改变了它面对的信息与执行条件。",
      "D": "不同且由响应决定的结束时刻改变平均误差的窗口，需要先固定共同评价时段。"
    }
  },
