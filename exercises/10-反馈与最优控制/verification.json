  "p10-feedback-sign": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "对应u=+Kx。",
      "B": "把u代回状态（state）方程即得。",
      "C": "维度和含义都不同。",
      "D": "不能这样表示该闭环。"
    }
  },
  "p10-fast-pole-cost": {
    "correct": [
      "A",
      "B",
      "C"
    ],
    "explanations": {
      "A": "闭环多项式由s²+3s+2变为s²+30s+200，位置与速度增益分别从2、3增至200、30；初始输入还取决于初态两分量的组合。",
      "B": "两个极点的实部都变得更负，理想模型中对应的指数衰减更快。",
      "C": "实际输入受到上限约束，反馈也可能使用含误差的测量值，因此实际响应可能偏离理想模型的预测。",
      "D": "双积分闭环多项式由目标根乘积决定位置增益，根均放大10倍使该增益放大100倍。"
    }
  },
  "p10-pole-placement-condition": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "只有部分方向不可控，不代表可控部分也不能配置。",
      "B": "状态反馈不会创造缺失的可控方向。",
      "C": "固定一个平均值不替代不可控模态本身的固定约束。",
      "D": "秩1只提供一个可控状态（state）方向，不可控模态无法用该输入任意移动。"
    }
  },
