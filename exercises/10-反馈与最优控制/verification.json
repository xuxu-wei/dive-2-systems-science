  },
  "p10-pole-to-time": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "外部扰动移除后，负实部对应的自然响应分量随时间衰减。",
      "B": "饱和改变输入与状态的线性关系，原固定闭环矩阵不再描述整个过程。",
      "C": "非零虚部带来正弦和余弦分量，负实部同时使其包络衰减。",
      "D": "特征根给出自然动态的信息，输入幅度、噪声大小及其传递还需另算。"
    }
  },
  "p10-root-locus-meaning": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "固定分子的根是开环零点，不是不同 K下的全部闭环特征根。",
      "B": "固定分母的根是开环极点，可以给出起点信息，但没有记录随 K移动的闭环根。",
      "C": "每个 K对应1+KG(s)=0的根，改变 K并跟踪这些根就得到根轨迹。",
      "D": "幅值为1的频率属于增益交叉问题，与 s平面中的闭环根是不同对象。"
    }
  },
  "p10-delay-approximation": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "近似极点来自所选表示，不必一一对应真实对象新增的物理储存状态。",
      "B": "低频接近没有证明交叉频率或高频处也接近，须检查实际相关范围。",
      "C": "纯延迟幅值为1，但相位为−ωd，去掉它可能改变闭环稳定性。",
      "D": "直接比较原延迟与近似的幅相，才能说明近似在哪一段频率内适用。"
    }
  },
