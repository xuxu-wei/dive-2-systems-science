  "p10-sensor-position": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "C₁及C₁A分别为[1,0]和[0,1]；C₂A=0。",
      "B": "观测（observation）位置可由其变化推速度；观测速度不能恢复未知位置偏移。",
      "C": "只测x₂的能观矩阵（matrix）秩（rank）1，x₁初态差异不可见。",
      "D": "只测x₁时两行独立，已覆盖二维状态（state）。"
    }
  },
  "p10-known-input": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "这只有两者均使用相同输入或Bu=0等情况下才成立。",
      "B": "真实系统含+Bu，估计漏掉它，误差x−xhat应为+Bu。",
      "C": "真实状态（state）按Ax+Bu推进，估计按Axhat推进，两者相减保留Bu。",
      "D": "Bu是已知外部输入项，不能在维度和变量不符时合并进误差矩阵（matrix）。"
    }
  },
  "p10-observability-vs-noise": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "可观性是已知模型（model）无噪条件下的唯一性，实际精度还受噪声及条件数（condition number）影响。",
      "B": "能观性（observability）可能依靠多个时刻的不同投影（projection），单个读数未必足够。",
      "C": "满秩只要求奇异值非零，不保证各方向条件相同。",
      "D": "数值表示精度不等于新增测量信息，无法删除已有随机误差。"
    }
  },
