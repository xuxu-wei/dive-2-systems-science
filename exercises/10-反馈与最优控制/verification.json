  "p10-actuator-position": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "AB₁=[1,0]ᵀ与B₁独立，秩2；AB₂=0，只有B₂一个独立方向，秩1。",
      "B": "第二种配置的AB₂为零，没有第二个独立方向。",
      "C": "第一种配置可以通过第二状态传播到第一状态，第二种配置无法改变第二状态，次序被颠倒。",
      "D": "第一种配置已有两个独立列，不能只凭B只有一列就判为秩1。"
    }
  },
  "p10-rank-tolerance": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "可逆变换保持精确秩，但会改变数值尺度；检查奇异值并说明相应容差，才能解释数值判定。",
      "B": "固定绝对阈值可能受坐标尺度影响，跨过阈值本身不能说明对象的能控性变化。",
      "C": "舍入为整数改变了原矩阵，可能删除小但真实存在的作用方向。",
      "D": "行列式大小依赖单位，不能作为不同尺度下控制难易的直接比较。"
    }
  },
  "p10-controllable-not-feasible": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "持续u=1得到速度增量1，位置增量是0.5，而非1；本题也没有终端速度约束可用于补足位置。",
      "B": "无约束能控性没有保证给定输入上限和1 s时长下任意位置可达。",
      "C": "位置为∫₀¹(1−t)u(t)dt；u≤1给最大值1/2，因此到不了2。",
      "D": "权重1−t在此时段非负，加入负输入只会减少位置，不能超过持续u=1。"
    }
  },
