{
  "p10-pi-saturation": {
    "cases": [
      {
        "arguments": {
          "error": 2.0,
          "integral": 0.0,
          "dt": 1.0,
          "kp": 1.0,
          "ki": 1.0,
          "limit": 2.0
        },
        "expected": [
          2.0,
          2.0,
          0.0
        ]
      },
      {
        "arguments": {
          "error": -1.0,
          "integral": 3.0,
          "dt": 0.5,
          "kp": 1.0,
          "ki": 1.0,
          "limit": 2.0
        },
        "expected": [
          1.5,
          1.5,
          2.5
        ]
      },
      {
        "arguments": {
          "error": 0.0,
          "integral": 1.0,
          "dt": 1.0,
          "kp": 2.0,
          "ki": 1.0,
          "limit": 2.0
        },
        "expected": [
          1.0,
          1.0,
          1.0
        ]
      }
    ],
    "explanation": "首例候选请求为4，正误差继续推动正限幅，冻结积分后请求与实际输入都为2。"
  },
  "p10-pi-constant-load": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "P控制需要持续误差才能产生抵消扰动的输入，因此可能留有稳态误差。",
      "B": "积分项累积误差，稳定且未饱和时可提供抵消恒定扰动所需的输入，使误差趋近于0。",
      "C": "对这里的恒定扰动，P控制可能留有稳态误差，而满足题设条件的PI控制可使该误差趋近于0。",
      "D": "同一个输入增量可能使不同对象的输出增大或减小；反馈（feedback）方向需要与该作用以及误差定义一起判断。"
    }
  },
  "p10-request-vs-actuation": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "实际只能执行5，按8推进会使仿真对象违背执行限幅。",
      "B": "既忽略执行限幅，又把请求值记错。",
      "C": "推进值正确，但把请求与执行日志颠倒了。",
      "D": "对象受真实执行值驱动，另存请求值可诊断饱和程度。"
    }
  },
  "p10-gain-units": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "e为U而u为U/T，比例项需除时间；积分项还要再除一次时间。",
      "B": "量纲（dimension）颠倒。",
      "C": "积分项多一个T。",
      "D": "两项都应为U/T。"
    }
  },
