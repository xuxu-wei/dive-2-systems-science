  "p02-time-constant": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "有限时间指数衰减仍为正，不会在一个时间常数后变为零。",
      "B": "50%对应半衰期（half-life）ln(2)/k，不是1/k。",
      "C": "代入t=1/k，剩余比例为exp(−1)≈0.368。",
      "D": "63.2%是已清除的比例1−exp(−1)，而非剩余比例。"
