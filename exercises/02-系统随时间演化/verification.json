  "p02-balance-limit": {
    "correct": [
      "B",
      "D"
    ],
    "explanations": {
      "A": "−5 U不是仅由近零残差便可认定的舍入误差（round-off error）；账目对上不保证状态（state）合理。",
      "B": "残差检验离散等式，非负性检验物理解释，二者回答不同问题。",
      "C": "改变新状态但不改流量（flow），会使原等式残差改变5 U。",
      "D": "段首清除速率持续过久可导致过量清除，应检查步长与近似。"
    }
  },
  "p02-slope-meaning": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "所追踪物质总量（tracked amount）变化除以时间得到变化率。",
      "B": "展开 (1+h)² 得到 2+h。",
      "C": "有限区间平均变化不等于一般的瞬时变化。",
      "D": "这是导数定义在该二次函数上的结果。"
    }
  },
  "p02-difference": {
    "cases": [
      {
        "arguments": {
          "t": 1,
          "h": 0.5
        },
        "expected": 2.5
      },
      {
        "arguments": {
          "t": 0,
          "h": 0.1
        },
        "expected": 0.10000000000000002
      },
      {
        "arguments": {
          "t": 2,
          "h": 0.01
        },
        "expected": 4.009999999999891
      },
      {
        "arguments": {
          "t": 3,
          "h": 0.0001
        },
        "expected": 6.000100000012054
      }
    ],
    "explanation": "可用代数恒等式 2t+h 检查差分结果。"
  },
  "p02-limit-not-zero": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "原函数在1处有定义且A(1)=1；未定义的是原差商的0/0。",
      "B": "2+h在h趋零时趋向2，并不发散。",
      "C": "h≠0时差商为2+h，不等于其极限（limit）2。",
      "D": "h非零时可约去h，得到2+h，再求极限为2。"
    }
  },
  "p02-difference-noise": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "前向差分在光滑条件下的截断误差通常随h减小而减小。",
      "B": "差值中的浮点误差再除以小h，可能盖过已减小的截断误差。",
      "C": "步长改变不会改变原函数的连续性，现象来自数值计算。",
      "D": "差商在理想极限（limit）下趋向导数（derivative），而不是函数值。"
    }
  },
  "p02-area-unit": {
    "correct": [
      "A",
      "C"
    ],
    "explanations": {
      "A": "流率（flow rate）乘时间后累计为总量。",
      "B": "遗漏起点。",
      "C": "只有流入时，末量=初量+累计流入。",
      "D": "积分带来一个时间因子，单位为 U。"
    }
  },
