  "p02-truncation": {
    "correct": [
      "A",
      "C"
    ],
    "explanations": {
      "A": "O(1/h)次一步误差累积，稳定传播下得到一阶全局误差。",
      "B": "这里漏计了固定时长内随h减小而增加的更新次数。",
      "C": "浮点误差不会因为截断误差降低就自动消失，极小时可能明显。",
      "D": "固定总时间内h减半使更新次数加倍，而非减半。"
    }
  },
  "p02-fair-refinement": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "同一初值问题（initial value problem）和相同终点下，主要变化是网格精细程度。",
      "B": "相同步数给出不同物理终点，误差差异不只来自步长。",
      "C": "第二组换了起始状态（state）和演化范围，已不是同一问题对照。",
      "D": "不同终点混入演化时间影响，不能直接作为同终点细化比较。"
    }
  },
  "p02-zero-error": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "0/0不是1，无法由这两个零误差求阶数。",
      "B": "方法一般一阶不意味着本例0/0能取成2。",
      "C": "阶数估计log2(E(h)/E(h/2))需要有意义的误差比，此例不满足。",
      "D": "零误差不提供误差随h缩放的比例，不能认定比值4。"
    }
  },
