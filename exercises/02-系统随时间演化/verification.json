  "p02-integration-constant": {
    "correct": [
      "B",
      "C",
      "D"
    ],
    "explanations": {
      "A": "初始所追踪物质总量（tracked amount）不同。",
      "B": "两者差的导数（derivative）为零，差保持初始的 3。",
      "C": "导数相同的函数相差常数；代入各自初值可确定该常数项。",
      "D": "求导并代入初值可同时核验。"
    }
  },
  "p02-ivp": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "一阶方程给定一个时刻的状态（state），就能确定本例解的常数项。",
      "B": "时间网格（time grid）没有指定曲线在任一时刻的总量。",
      "C": "观察范围和单位不能代替一个状态值。",
      "D": "算法与步长决定近似的计算方式，仍缺少从哪里开始。"
    }
  },
