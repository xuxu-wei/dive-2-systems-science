  "p02-chain-factor": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "内层导数是常数 −2，不是 t。",
      "B": "外层指数求导后，乘内层 −2t 的导数（derivative） −2。",
      "C": "这不是复合函数的求导规则。",
