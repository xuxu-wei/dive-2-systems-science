          4.1472
        ]
      },
      {
        "arguments": {
          "initial": 0,
          "factor": 1.1,
          "steps": 3
        },
        "expected": [
          0,
          0.0,
          0.0,
          0.0
        ]
      },
      {
        "arguments": {
          "initial": 7,
          "factor": 0,
          "steps": 2
        },
        "expected": [
          7,
          0,
          0
