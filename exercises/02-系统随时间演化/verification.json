{
  "p02-step-factor": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "若每半步乘0.8，一整步剩0.64，与原来的0.8不同。",
      "B": "0.4是把保留比例除2，两次作用后只剩0.16。",
      "C": "半步比例r需满足r²=0.8，取非负比例得sqrt(0.8)。",
      "D": "0.9把损失20%均分成两次10%，但复合保留比例为0.81。"
    }
  },
  "p02-growth": {
