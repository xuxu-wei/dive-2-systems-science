  "p02-ftc": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "累计量是流率（flow rate）的时间积分，通常不等于瞬时流率。",
      "B": "下限固定为0，其对应项对t的导数（derivative）为零，无需减u(0)。",
      "C": "先积分再求导恢复u，而不是再多求一次导数（derivative）。",
      "D": "u连续时，对上限t求导得到u(t)。"
    }
  },
  "p02-jump-area": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "有限流率在零时长内不能搬运有限所追踪物质总量（tracked amount）。",
      "B": "左斜率为 2，右斜率为 0。",
      "C": "速率跳变不是总量跳变。",
      "D": "应分别解释分段内的变化率和边界。"
    }
  },
  "p02-exponent-unit": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "这样乘积 kt 才能进入指数。",
      "B": "指数函数（exponential function）的自变量需要没有物理单位。",
      "C": "时间单位改变，系数数值也需同步换算。",
      "D": "代入 t=0 即可核对初值（initial condition）。"
    }
  },
