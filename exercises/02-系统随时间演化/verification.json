  "p02-zero-clearance": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "忽略了持续输入（input），导数（derivative）为0而题设要求2。",
      "B": "此时A′=2，积分并代入初值（initial condition）得3+2t。",
      "C": "指数衰减的导数不是常数2，且误把输入当清除系数（elimination rate constant）。",
      "D": "导数正确但初值为0，漏掉初始3 U。"
    }
  },
