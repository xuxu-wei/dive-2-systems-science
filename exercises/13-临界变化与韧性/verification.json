  },
  "p13-connected-not-functional": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "路径存在不代表沿途有足够容量。",
      "B": "拓扑连接与节点处理能力是两个不同指标。",
      "C": "容量下降不直接改变题设仍连通的节点集合。",
      "D": "题设没有把容量不足定义为删边。"
    }
  },
  "p13-control-one-factor": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "单因素对照使两种干预的影响可分别比较。",
      "B": "联合改变只能得到联合效果，不能直接拆分贡献。",
      "C": "种子变化也会改变级联。",
      "D": "初始损伤减少会混入阈值作用。"
    }
  },
  "p13-threshold-monotonic": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "第0轮损伤是题设固定的种子，改变后续失效阈值不会删去这些种子。",
      "B": "提高阈值后可以不发生任何变化，例如原网络本来就没有继发失效。",
      "C": "更高阈值使失效更难触发，逐轮比较可知新失效集合始终包含在原规则的失效集合中。",
      "D": "失效集合可能保持相同，所以剩余最大连通分量（connected component）不一定增加节点。"
    }
  },
  "p13-recovery-trajectory": {
