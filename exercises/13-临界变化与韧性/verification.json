  "p13-direct-vs-secondary": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "第0轮是直接损伤，后续两轮新增是继发；三者合计3个。",
      "B": "把后续新增的两个节点也误记为直接损伤。",
      "C": "累计集合须去重，不能把各轮累计数1、2、3再次相加。",
      "D": "遗漏了第1、2轮的两个继发失效。"
    }
  },
  "p13-cascade-no-seed": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "孤立节点的失效邻居数也是零。",
      "B": "高总度数不等于有失效邻居。",
      "C": "正阈值要求至少一个失效邻居，零种子无法启动级联。",
      "D": "零失效邻居在任何规模都低于正阈值。"
    }
  },
  "p13-cascade-is-not-contagion": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "这是题设明示的不可逆计数阈值规则。",
      "B": "概率接触与恢复属于另一类传播机制。",
      "C": "负载重分配需要额外规则，题设未包含。",
      "D": "连续状态与恢复不属于该二值不可逆模型（model）。"
    }
  },
