  },
  "p13-ar1-warning-condition": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "一步相关等于rho，随0.5到0.9增大。",
      "B": "方差分母减小，因此方差增大。",
      "C": "方差为sigma²/(1−rho²)，分母减小；一步相关为rho。",
      "D": "固定噪声不表示固定状态（state）方差，rho已改变。"
    }
  },
  "p13-noise-control": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "噪声幅度改变不改变该模型（model）的一步相关rho。",
      "B": "把标准差比例当成方差比例。",
      "C": "方差随噪声标准差的平方变动，(0.5/0.2)²=6.25；rho未变。",
      "D": "方差应变化，而一步相关不变。"
    }
  },
  "p13-lag-physical-time": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "物理时差=样本滞后×采样间隔，两者均需为1T。",
      "B": "新数据对应0.5T，不是1T。",
      "C": "旧数据对应2T，新数据对应0.5T。",
      "D": "新数据是1T，但旧数据是2T。"
    }
  },
