  "p13-scale-identifiability": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "对数需空间排列信息。",
      "B": "同一平均可对应多个位置排列。",
      "C": "已知格数N时，Np给出1的总数，但平均是多对一映射。",
      "D": "当前总数可确定，未来总数还依赖局部排列与规则。"
    }
  },
  "p13-pair-not-universal": {
    "correct": [
      "A"
    ],
    "explanations": {
