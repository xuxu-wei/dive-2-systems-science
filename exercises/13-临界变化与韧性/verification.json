{
  "p13-finite-order-summary": {
    "cases": [
      {
        "arguments": {
          "paths": [
            [
              0.0,
              0.2,
              -0.4
            ],
            [
              0.0,
              -0.4,
              -0.2
            ]
          ],
          "burnin": 1
        },
        "expected": [
          0.30000000000000004,
          0.0
        ]
      },
      {
        "arguments": {
          "paths": [
            [
              1.0,
              0.5,
              0.25
            ],
            [
              -1.0,
              -0.5,
              -0.25
            ]
          ],
          "burnin": 1
        },
        "expected": [
          0.375,
          0.0
        ]
      },
      {
        "arguments": {
          "paths": [
            [
              0.0,
              0.0,
              1.0
            ],
            [
              0.0,
              0.5,
              0.5
            ]
          ],
          "burnin": 1
        },
        "expected": [
          0.5,
          0.0
        ]
      }
    ],
    "explanation": "先在重复内部取尾窗绝对值，再在重复之间汇总；不把一次轨迹的波动当成重复间不确定性。"
  },
  "p13-signed-vs-absolute": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "混淆了均值的绝对值和绝对值的均值。",
      "B": "正负符号抵消，而绝对值先取后平均保留幅度。",
      "C": "先去掉符号再平均，算到的是绝对值均值。",
      "D": "有符号平均应抵消，绝对值平均不应抵消。"
    }
  },
  "p13-finite-fluctuation": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "忽略了 N 个独立抽样的平均。",
      "B": "平均会使独立抽样方差按1/N缩小。",
      "C": "确定的是条件期望（conditional expectation），不是有限样本的下一步。",
      "D": "磁化是 ±1 的平均，每项方差4r(1-r)，独立平均再除以 N。"
    }
  },
  "p13-finite-evidence": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "单个参数处的长窗口不足以估计临界标度。",
      "B": "插值只改变显示，不能新增规模信息。",
      "C": "有限规模（finite size）单次跳变并未确定其他规模的阈值。",
      "D": "重复可展示波动，规模比较可检查有限规模（finite size）效应。"
    }
  },
  "p13-deterministic-meanfield": {
    "cases": [
      {
        "arguments": {
          "beta": 0.0,
          "start": 0.4,
          "steps": 2
        },
        "expected": [
          0.4,
          0.0,
          0.0
        ]
      },
      {
        "arguments": {
          "beta": 1.2,
          "start": 0.2,
          "steps": 3
        },
        "expected": [
          0.2,
          0.23549574953849794,
          0.2753050142817213,
          0.31884962124176486
        ]
      },
      {
        "arguments": {
          "beta": 0.8,
          "start": -0.3,
          "steps": 1
        },
        "expected": [
          -0.3,
          -0.23549574953849794
        ]
      }
    ],
    "explanation": "tanh(0)=0；零步情形不应自行更新。有限随机系统还存在抽样波动。"
  },
  "p13-meanfield-threshold": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "零固定点斜率为beta，模小于1收缩，大于1放大。",
      "B": "把离散映射的稳定判据方向反了。",
      "C": "有界并不等于零点（zero）附近扰动衰减。",
      "D": "非线性形式本身不能判定局部稳定。"
    }
  },
  "p13-size-comparison": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "挑最高重复产生随规模变化的选择偏差。",
      "B": "这些记录使规模变化与观测（observation）预算、初态等条件可区分。",
      "C": "更新机制同时改变，无法单独解释规模效应。",
      "D": "终点可能仍在暂态，绘图宽度无法统一统计窗口。"
    }
  },
  "p13-critical-language": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "有限随机轨迹（trajectory）有波动，平均映射的分岔值不指定每一次随机跳变位置。",
      "B": "有限规模（finite size）的曲线趋势还不能给出无限规模的精确临界值。",
      "C": "随机模型本身有抽样波动，不能把这些波动都归于数值实现。",
      "D": "前者研究确定性固定点（fixed point）的稳定性，后者记录有限规模（finite size）与有限时间下的随机统计结果。"
    }
  },
