  },
  "p13-sensitivity-range": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "函数整体变动界不能直接当成逐点导数（derivative）界。",
      "B": "这是题设在给定模型（model）、区间和指标下直接核验的量。",
      "C": "未检查区间外，不能沿用此界。",
      "D": "参数变化未覆盖结构变化。"
    }
  },
  "p13-capstone-finite-claim": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "参数（parameter）插值的点数不是系统规模。",
      "B": "单个范围的斜率没有建立有限规模（finite size）标度关系。",
      "C": "挑平滑结果会丢失真实波动。",
      "D": "检查观察时长与重复波动有助于判断规模趋势是否稳健。"
    }
  },
  "p13-capstone-basin": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "局部率题定相同；1<1.5<2，有限扰动只处在第二个正向域内。",
      "B": "1.5超过第一个正向边界1。",
      "C": "局部率相同，且1.5没有超过第二个边界2。",
      "D": "局部率相同，扰动位于第二个域内。"
    }
  },
  "p13-capstone-cascade": {
