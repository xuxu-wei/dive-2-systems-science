    "explanation": "小正扰动朝0返回；超过边界的正扰动先远离0，不能把局部速率外推至全域。"
  },
  "p13-local-rate-vs-basin": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "线性项系数是−rate，不受二次项分母影响。",
      "B": "rate未变，边界才发生变化。",
      "C": "f'(0)=−rate不含boundary，正不稳定平衡（equilibrium）位于boundary。",
      "D": "非零平衡从1移到了2。"
    }
  },
  "p13-finite-perturbation": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "更小扰动仍只检验局部线性行为。",
      "B": "局部率精度提高不能提供远处方向。",
      "C": "初始向零变化不排除中途进入另一平衡，需要了解沿途动力学。",
      "D": "有限扰动可能跨越吸引域（basin of attraction）边界，需要沿途非线性信息。"
    }
  },
  "p13-recovery-euler-step": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "插值不改变离散更新。",
      "B": "末点依赖步数奇偶，不能确认连续振荡。",
      "C": "显式Euler可能因乘子为负产生交替，细化可区分数值与模型（model）行为。",
      "D": "抽点可隐藏交替，不能解决时间离散误差。"
    }
  },
