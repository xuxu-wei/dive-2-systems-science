  "p11-volume-equilibrium": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "共同浓度为8/(1+3)=2 U/L，各室总量为浓度乘容积。",
      "B": "总量相等时浓度分别为4和4/3 U/L，仍有净交换。",
      "C": "比例正确，但总量只剩4 U，不满足守恒。",
