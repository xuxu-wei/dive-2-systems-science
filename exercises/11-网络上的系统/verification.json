  "p11-volume-equilibrium": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "交换停止时浓度相同，为8/(1+3)=2 U/L。乘各自容积后得到2 U和6 U。",
      "B": "4 U和4 U对应的浓度为4 U/L和4/3 U/L，仍有浓度差。",
      "C": "1 U和3 U虽有相同浓度，但总量和为4 U，少于守恒的8 U。",
      "D": "6 U与2 U对应的浓度为6 U/L和2/3 U/L，尚未平衡。"
    }
  },
  "p11-euler-too-large": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "两个数相加为1，但第一室总量为负。总和检查不能代替逐室非负检查。",
      "B": "−0.5+1.5=1 U，总量守恒；第一项−0.5 U使非负性检查不通过。",
      "C": "这一步总量和仍为1 U，负值发生在各室的分配上。",
      "D": "连续对称交换从非负初态保持非负；这里的负值来自过大的显式步长。"
    }
  },
  "p11-spectral-gap": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "特征值是衰减率，单位1/T；时间须由指数里的无量纲乘积求出。",
      "B": "模态幅度比为exp(−λt)。令λt=1，得t=1/λ，依次为5 T与2 T。",
      "C": "0.5/T的衰减率更大，相应时间更短；两个时间的次序反了。",
      "D": "相同的幅度比要求相同的λt，并不要求t相同。"
    }
  },
