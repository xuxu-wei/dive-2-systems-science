  "p11-edge-semantics": {
    "correct": [
      "A",
      "B"
    ],
    "explanations": {
      "A": "交换规律要说明比较的是总量还是浓度，再用有相应单位的系数把差值换成流率。",
      "B": "感染判定需要每次接触成功的概率；“每次”所对应的时间步也属于规则。",
      "C": "交换系数带有时间单位，而一步感染概率没有单位。时间单位或步长改变时，两种量如何换算须由各自机制确定。",
      "D": "绘图软件安排线长是为了显示连接；接触次数需由数据或接触规则给出。"
    }
  },
  "p11-hand-drawn-path": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "新增边分别接到0号与3号，两个端点的度各增加1；原路径已经连通。",
      "B": "加入边后形成四节点环，各节点都连着两条边，四个节点互相可达。",
      "C": "所有节点沿环相互可达，应属于同一个分量。",
      "D": "1号和2号仍各接两条边，0号和3号也各接两条，尚未形成完全图。"
    }
  },
  "p11-degree-sum": {
    "correct": [
      "A",
      "B"
    ],
    "explanations": {
      "A": "逐条数边时，每条边的两个端点各贡献1，合计为2m。",
      "B": "无自环使两端点不同；一条无向边分别进入两个节点的度。",
      "C": "度和为2m，除以节点数后平均度为2m/n。",
      "D": "两个彼此断开的三角形中，每个节点的度都是2，却有两个连通分量。"
    }
  },
