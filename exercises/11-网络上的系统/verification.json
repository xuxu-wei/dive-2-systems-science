  "p11-finite-scan-threshold": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "这两个操作分别检查离散化和暂态（transient）是否影响结果。",
      "B": "扫描更密有助于定位变化，但未改变步长误差或暂态（transient）长度。",
      "C": "插入显示帧没有改变动力学计算。",
      "D": "挑最大值改变结果选择方式，也未检验步长和运行时长。"
    }
