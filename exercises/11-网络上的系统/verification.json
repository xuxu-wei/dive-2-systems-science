  "p11-matched-edge-budget": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "只选路径最短的一张图，估计的是所选极端结果，不能显示这组网络通常怎样变化。",
      "B": "增加远处连接也增加了边数，路径变化同时包含连接数量的影响。",
      "C": "节点数加倍改变了规模，平均度相同仍不能保持路径问题相同。",
      "D": "同规模、同边数下生成多张图，可以比较连接位置的变化及网络实现之间的散布；断连图还须单列报告。"
    }
  },
  "p11-power-law-evidence": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "一条直线的拟合程度没有回答其他候选分布是否也能解释这些数据。",
      "B": "按是否落在直线上删节点，会把结果选择混入分布判断。",
      "C": "比较候选分布及小样本下的波动，才能评估这段直线提供多少区分依据。",
      "D": "节点计数除以相同总数只改变纵轴尺度，没有增加用来区分候选分布的信息。"
    }
  },
  "p11-rewire-repeats": {
    "correct": [
      "A",
      "B"
    ],
    "explanations": {
      "A": "每次移除一条并加入一条，边的总数保持。",
      "B": "另一端选到哪个节点会改变三角形和最短路径，统计量可在重复生成间波动。",
      "C": "被移除和新增的另一端可能是不同节点，其度会分别减少或增加。",
      "D": "图的连接也在改变；传播结果的差异包含网络变化，不能全部归于感染抽样。"
    }
  },
