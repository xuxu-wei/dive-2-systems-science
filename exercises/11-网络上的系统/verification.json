  "p11-synchronous-order": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "这是让新感染者立即继续传播的连锁更新，不符合读取旧状态的规则。",
      "B": "2号的邻居1号在旧状态中仍为S，不能在本步把感染传给2号。",
      "C": "2号没有旧感染邻居；1号却与0号接触，应当感染。",
      "D": "旧感染者只有0号，只有1号能在这一步新感染。"
    }
  },
  "p11-per-edge-budget": {
