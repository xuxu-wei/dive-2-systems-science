  "p11-edge-conservation": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "两端一减一加保持总和，但3 U/T漏乘了0.5/T。",
      "B": "两端变化率的和为−1.5 U/T，且分别乘各自总量没有合成双向交换的差值。",
      "C": "净流率为0.5×(4−1)=1.5 U/T；第一节点减1.5，第二节点加1.5。",
      "D": "较多的第一节点应减少，符号应为负；第二节点接收这份总量。"
    }
  },
  "p11-directed-warning": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "两式相加得x₁−x₂，一般不为0；相等时两个变化率都为0，状态不会远离。",
      "B": "相等状态的判断成立，但总和变化率的符号反了。",
      "C": "−x₁+x₂+2x₁−2x₂=x₁−x₂；当x₁=x₂时两条方程右侧均为0。",
      "D": "行和为0使两个变量相等时静止；总和是否守恒要检查列和或将方程相加。"
    }
  },
  "p11-zero-mode": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "只有0、1之间有通道，不能把2号的总量也混入全图平均。",
      "B": "2号没有交换也没有清除，其10 U不会消失。",
      "C": "0、1的总量差非零，会交换到相等，初态不会保持。",
      "D": "0、1的总量和为8 U，等容积平衡时各4 U；2号一直保持10 U。"
    }
  },
