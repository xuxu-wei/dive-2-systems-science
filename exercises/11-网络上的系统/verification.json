  "p11-per-edge-budget": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "两次成功的事件会重叠；将0.2与0.2相加多计了两次都成功的0.04。",
      "B": "每条边的成功概率相同，但第二个节点有两次机会。",
      "C": "第一节点为0.2；第二节点两次都失败的概率为0.8²，故至少一次成功为1−0.8²=0.36。",
      "D": "0.2²=0.04是两次都成功的概率，感染只需至少一次成功。"
    }
  },
  "p11-extinction-vs-mean": {
