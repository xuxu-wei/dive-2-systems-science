  "p11-edge-conservation": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "这组守恒，但漏掉了0.5/T这一系数。",
      "B": "分别乘各自总量忽略了两个方向合成后的净交换。",
      "C": "0.5×(4−1)=1.5，一端减少多少，另一端就增加多少。",
      "D": "符号反了：正净流率从总量较多的第一节点流向第二节点。"
    }
  },
  "p11-directed-warning": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "总和导数为x₁−x₂，一般不为0；两状态相同时两导数均为0。",
      "B": "相加后的符号应为x₁−x₂。",
      "C": "直接相加得x₁−x₂；代入x₁=x₂得两个导数均为0。",
      "D": "行和为0说明常量向量（vector）不变，不能推出总和守恒或每个初态不变。"
    }
  },
  "p11-zero-mode": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "跨越不相连的分量取全局均值，假设了并不存在的交换。",
      "B": "孤立节点没有交换也没有清除，其总量不会变为0。",
      "C": "相连节点的初态不相等，会发生交换。",
      "D": "0、1号守恒总量8并趋于各4；孤立节点保持10。"
    }
  },
