  "p11-same-frequencies": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "分别挑选初态改变了所比较的起点条件。",
      "B": "节点上的频率位置与连接方式一起变了。",
      "C": "耦合强度也变了，差异不能仅归于连接方式。",
      "D": "每对只改连接方式，再检查结果是否依赖于某种频率分配。"
    }
  },
  "p11-network-contract": {
    "correct": [
      "A",
      "D"
    ],
    "explanations": {
      "A": "系数乘总量差同时给出正确数值与U/T单位。",
      "B": "连续速率和离散一步概率不同；更换时间步需要相应的转换关系。",
      "C": "流率乘时间得到的是0.6 U的交换总量；它不是无量纲（dimensionless）的感染概率。",
      "D": "至少一次成功为1−0.8²=0.36。"
    }
  },
  "p11-propagation-budget": {
