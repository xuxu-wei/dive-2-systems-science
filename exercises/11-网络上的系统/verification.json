  "p11-edge-semantics": {
    "correct": [
      "A",
      "B"
    ],
    "explanations": {
      "A": "交换规律把状态（state）差转换为流率，需要同时明确状态和系数的单位。",
      "B": "接触边的感染判定涉及概率和时间步，是传播模型（model）的一部分。",
      "C": "交换系数与概率的单位、时间含义不同，数值相同不能替代换算和机制定义。",
      "D": "图的布局距离是显示结果；若要表示接触次数，需要另外的数据或模型关系。"
    }
  },
  "p11-hand-drawn-path": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "忽略了新边。",
      "B": "形成四节点环，每个节点恰好接两条边。",
      "C": "环是连通的。",
      "D": "每个节点没有三条边。"
    }
  },
  "p11-degree-sum": {
    "correct": [
      "A",
      "B"
    ],
    "explanations": {
      "A": "每条无向边贡献两个端点计数，合计2m。",
      "B": "无自环时两端点不同，各计一次。",
      "C": "平均度是2m/n，m/n少计了一端。",
      "D": "两个互不相连的三角形中各节点度均为2，但有两个连通分量。"
    }
  },
