  "p11-matched-edge-budget": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "挑选极端结果会掩盖典型路径长度及其波动。",
      "B": "增加边同时改变边数，路径缩短可能来自更多连接。",
      "C": "节点数变化也会影响路径长度，未保持规模一致。",
      "D": "这样比较的主要变化是连接位置；多张图还能显示随机重连的波动。"
    }
  },
  "p11-power-law-evidence": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "直线拟合没有与其他分布竞争，小样本的波动也可能形成近似直线。",
      "B": "事后删点会改变分析对象并提高表面上的直线程度。",
      "C": "候选模型（model）比较和不确定性检查，才能判断这段直线支持哪种解释。",
      "D": "归一化只改变纵轴整体尺度，未增加区分分布的证据。"
    }
  },
  "p11-rewire-repeats": {
    "correct": [
      "A",
      "B"
    ],
    "explanations": {
      "A": "一删一加保持总边数。",
      "B": "重连到哪些节点不同，会改变三角形与路径。",
      "C": "保留一端的重连可以改变其他端点的度，保持边数不等于保持各点的度。",
      "D": "图本身也在变化，传播差异包含网络结构的变化。"
    }
  },
