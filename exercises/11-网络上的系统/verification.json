    }
  },
  "p11-euler-too-large": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "守恒只限制两个数的和，并不保证它们分别非负。",
      "B": "两数之和为1，但第一项为负；应减小步长检查。",
      "C": "−0.5+1.5=1，守恒在这一步仍成立。",
      "D": "该连续对称交换从非负初态保持非负；过大的Euler步长产生了非物理解。"
    }
  },
  "p11-spectral-gap": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "这里把衰减系数的数值直接当成时间，没有取倒数。",
      "B": "模态按exp(−λt)衰减，因此时间为1/λ。",
      "C": "较大的正特征值对应更快衰减，不能交换这两个时间。",
      "D": "同一个相对幅度要求不意味着相同时间，还取决于特征值。"
    }
  },
