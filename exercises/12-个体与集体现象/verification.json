            0.0
          ],
          [
            0.625,
            0.3125,
            0.0625,
            0.0
          ]
        ]
      },
      {
        "arguments": {
          "values": [
            0.0,
            2.0,
            0.0
          ],
          "diffusivity": 0.0,
          "dx": 1.0,
          "dt": 0.5,
          "steps": 2,
          "boundary": "periodic"
        },
        "expected": [
          [
            0.0,
            2.0,
            0.0
          ],
          [
            0.0,
            2.0,
            0.0
          ],
          [
            0.0,
            2.0,
            0.0
          ]
        ]
      }
    ],
    "explanation": "周期边界的单脉冲向两端扩散；无通量端点无跨界通道。"
  },
  "p12-diffusion-cfl": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "中心权重1−2α与邻格权重α都非负要求0≤α≤1/2。",
      "B": "α>1/2时中心权重为负。",
      "C": "把条件中的2移到分子会得到错误范围。",
      "D": "非负α尚不能控制中心权重的符号。"
    }
  },
  "p12-noflux-end": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "使越界浓度差为零，符合单元中心守恒离散。",
      "B": "首尾连接属于周期边界（periodic boundary）。",
      "C": "镜像第二格对应另一种网格位置约定。",
      "D": "固定为零一般会产生边界通量。"
    }
  },
  "p12-mass-not-enough": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "总量输出精度不能判断局部负浓度是否来自离散更新。",
      "B": "显式更新的负权重可能产生负浓度，减小时间步并检查权重可以核验这一来源。",
      "C": "裁剪改变了浓度与总量，裁剪前的守恒结果不能验证修改后的数值。",
      "D": "重新分配改变了原离散演化，即使保住总量，也未证明处理后数值满足扩散方程。"
    }
  },
