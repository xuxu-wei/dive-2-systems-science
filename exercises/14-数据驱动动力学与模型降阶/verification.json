  "p14-initial-projection": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "坐标由 Uᵀ(initial−mean) 取得；与 U 正交的分量内积为零，初始化时便没有进入重建。",
      "B": "投影先于时间推进发生，误差在第一次更新之前就存在。",
      "C": "中心被减去后再加回，但题设正交剩余是相对于这一固定中心的，不能由中心补回。",
      "D": "时间步长改变后续更新，初始化投影仍由同一个中心和基决定。"
    }
  },
  "p14-conservation-projection": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "能量比例描述平方重建误差，没有规定各室之和或每一室的符号。",
      "B": "正交性保证投影的几何性质，但重建分量仍可为负，总量方向也可能丢失。",
      "C": "总量关系与分量符号分别对应两项要求，需要在降阶初始化和演化中检查。",
      "D": "中心只是表示的一部分；还需看保留方向、新初值坐标和后续更新。"
    }
  },
  "p14-time-vs-reduction": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "t=0 尚未更新，直接比较初始化投影即可量出已经丢失的方向。",
      "B": "绘制更多点不会改变同一个初始化状态。",
      "C": "改变步长仍不会改变尚未时间推进的投影结果。",
      "D": "训练整体重建比例没有包含新初值相对该基的所有信息。"
    }
  },
