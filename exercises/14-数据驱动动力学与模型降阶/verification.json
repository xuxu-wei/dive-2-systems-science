  "p14-energy-limit": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "误差本身应开平方，约为0.1。",
      "B": "截断误差（truncation error）平方为舍弃奇异值平方和，占总平方和1%。",
      "C": "矩阵（matrix）整体Frobenius范数比例不约束每一列的相对误差。",
      "D": "此比例只描述训练快照重建，不约束新轨迹（trajectory）。"
    }
  },
  "p14-holdout-basis": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "基已吸收留出方向，不能再评估未知初值（initial condition）的泛化。",
      "B": "中心也是拟合的变换参数（parameter），使用留出会泄漏。",
      "C": "中心、基与模型（model）选择均不应使用最终评估轨迹。",
      "D": "留出已用于选择秩，需要另保留最终测试。"
    }
  },
  "p14-sign-and-rank": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "改号作用在外积两侧，投影不会变号。",
      "B": "(−u)(−u)ᵀ=uuᵀ，两个负号抵消。",
      "C": "归一化u给出非零投影P，P²=P而不是零矩阵。",
      "D": "两者相同，差为零矩阵而非单位矩阵。"
    }
  },
