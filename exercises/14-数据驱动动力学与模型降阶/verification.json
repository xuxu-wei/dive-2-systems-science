  "p14-initial-projection": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "初始坐标来自向训练子空间的投影（projection），正交分量当即被去除。",
      "B": "投影在时间推进前已发生。",
      "C": "题定相对于训练仿射（affine）子空间仍有正交剩余时，中心不能补回。",
      "D": "步长控制时间误差，不能添加缺失方向。"
    }
  },
  "p14-conservation-projection": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "能量比例是矩阵（matrix）重建指标，不是物理约束。",
      "B": "正交性仅约束基的内积（inner product），不等于物理约束。",
      "C": "正交投影（orthogonal projection）可能丢失守恒方向，也可能重建出负分量。",
      "D": "训练均值不约束新初值（initial condition）与后续轨迹（trajectory）。"
    }
  },
  "p14-time-vs-reduction": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "t=0还未积分，直接比较投影（projection）可定位表示误差。",
      "B": "绘图间隔不改变初始化。",
      "C": "没有走时间步时，改步长不能改变初值投影。",
      "D": "训练能量不能直接量化新初值（initial condition）的覆盖。"
    }
  },
