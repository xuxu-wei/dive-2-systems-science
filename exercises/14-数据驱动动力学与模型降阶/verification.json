  "p14-one-step-rollout": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "重复拟合同一组列没有增加新初值，也没有检验连续预测。",
      "B": "配对不变的重排没有改变拟合问题或加入新的预测条件。",
      "C": "不断输入真实状态会纠正此前偏差，与只使用自身预测的任务不同。",
      "D": "新初值检验训练范围之外的状态，每步使用自身预测则检验误差如何在连续更新中传播。"
    }
  },
  "p14-null-direction": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "数据约束的是矩阵在训练列空间上的作用；未出现方向的作用仍可不同。",
      "B": "一个方向上的结果不足以确定整个二维矩阵。",
      "C": "指定更多方向不会让原本为零的奇异方向出现新信息。",
      "D": "同一方向上更多点仍属于原来的列空间，没有观测另一方向的响应。"
    }
  },
  "p14-paired-columns": {
    "correct": [
      "A"
