  "p14-ridge-bias": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "减去平方项会鼓励系数变大，与此处抑制大系数的目的相反。",
      "B": "岭目标在误差之外加入 lambda·||K||_F²，使较大系数需要付出额外目标值。",
      "C": "正负系数的和能相互抵消，没有体现每个系数的大小。",
      "D": "按项数相除没有给出这里的系数平方惩罚。"
    }
  },
  "p14-feature-drift": {
