  "p14-energy-limit": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "舍弃部分占平方和的 1%，相对误差应开平方，得到 0.1。",
      "B": "残差平方等于舍弃奇异值的平方和，因此整体相对误差平方为 1−0.99=0.01。",
      "C": "整体平方和的比例没有分别限定每一列的相对误差。",
      "D": "这里比较的是已给训练快照及其重建，没有计算新轨迹的预测误差。"
    }
  },
  "p14-holdout-basis": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "最终评估中的方向已经参与求基，得到的误差不再检验事先固定的训练表示。",
      "B": "中心决定投影的位置，也是从数据取得的参数，应与基一同只由训练轨迹确定。",
      "C": "中心和基先固定，再检查未参与拟合的新初值，能够检验这组表示的适用范围。",
      "D": "同一批轨迹已用于选择秩；要评价选择后的预测，需要另一组未参与选择的测试轨迹。"
    }
  },
  "p14-sign-and-rank": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "投影用向量与其转置的外积，改号同时发生在两侧，两个负号相消。",
      "B": "(−u)(−u)ᵀ=uuᵀ，所以改号保留同一条投影方向及同一个矩阵。",
      "C": "u 是单位向量，非零投影 P 满足 P²=P，不等于零。",
      "D": "两者之差为零；整体改号不会使投影多出一个单位矩阵。"
    }
  },
