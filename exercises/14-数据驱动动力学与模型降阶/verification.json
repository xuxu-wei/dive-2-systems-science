  "p14-column-conservation": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "行和为零说明A1=0，并不等于状态总和导数（derivative）为零所要求的1ᵀA=0。",
      "B": "总量导数（derivative）为1ᵀAx；要对所有初态都为零，必须有1ᵀA=0，即A的每列和为零。",
      "C": "某个特殊初值（initial condition）可能使总量不变，但其他初值仍可能产生总量变化。",
      "D": "对角元素之和是矩阵（matrix）的迹，它不等于1ᵀA，不能代替总量守恒条件。"
    }
  },
  "p14-euler-positive": {
