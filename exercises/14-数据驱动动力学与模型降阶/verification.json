  "p14-angle-alias": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "相角满足 2ω=0.5+2πk，除以 2 T 后得到这一完整集合。",
      "B": "k 为奇数时，额外相角是 π 的奇数倍，不是整圈。",
      "C": "乘以 2 T 后相角为 1+2πk，起始相角已不同。",
      "D": "这一组只包含正确集合中偶数 k 对应的频率，漏掉其余整圈分支。"
    }
  },
  "p14-eigen-modulus": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "0.8 只对应一次更新。",
      "B": "两次依次相乘：0.8×0.8=0.64。",
      "C": "每步乘一个比例，与每步减去固定的初始幅度份额不同。",
      "D": "连续更新把两个乘子相乘，而不是把它们相加。"
    }
  },
  "p14-local-operator": {
    "correct": [
