    "explanations": {
      "A": "同一列连接当前状态与一个采样间隔之后的状态。",
      "B": "这会配成向后一个间隔的关系。",
      "C": "这会配成向前两个间隔的关系。",
      "D": "两边是同一时刻的状态，得到的是保持该状态的关系。"
    }
  },
