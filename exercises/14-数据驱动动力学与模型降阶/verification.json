  "p14-initial-projection": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "初始坐标来自投影（projection），正交分量被丢弃。",
      "B": "训练列未覆盖新方向。",
      "C": "初值投影发生在任何时间步之前。",
      "D": "图像显示不能补回表示空间。"
    }
  },
  "p14-conservation-projection": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "投影可能删去守恒方向或产生负分量。",
      "B": "正交（orthogonality）性不等于物理约束保持。",
      "C": "训练误差不约束新初值（initial condition）。",
      "D": "矩阵（matrix）重建误差与守恒残差是不同指标。"
    }
