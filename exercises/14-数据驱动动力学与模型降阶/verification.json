  "p14-energy-limit": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "比例只说明当前快照的二范数（norm）能量分配。",
      "B": "新初值可以含训练未激发的方向，动态误差也不由训练能量直接界定。",
      "C": "数据方向不自动等同于机制。",
      "D": "尺度变化会改变奇异值和排序。"
    }
  },
  "p14-holdout-basis": {
