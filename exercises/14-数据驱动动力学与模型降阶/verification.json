  "p14-koopman-functions": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "次序颠倒，且标量观测值未必能作为状态映射输入（input）。",
      "B": "Koopman算子把观测函数与下一步状态映射复合。",
      "C": "相加不是下一步观测值的定义，值域也未必相同。",
      "D": "乘积不等于沿状态更新计算观测。"
    }
  },
  "p14-exact-closure": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "平方也必须作用于x。",
      "B": "平方必须同时作用于系数a。",
      "C": "x⁺=ax，两边平方得到a²x²。",
      "D": "把平方运算误用了求导的因子2。"
    }
  },
  "p14-readout": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "第一状态被错误加入x²。",
      "B": "第二项变成x²，未恢复y。",
      "C": "丢失x并把x²当成第二状态。",
      "D": "字典z=[x,y,x²]的前两项就是原状态（state）。"
    }
