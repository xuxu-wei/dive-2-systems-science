  "p14-one-step-rollout": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "重复拟合同一数据只能比较训练误差，没有提供新初值上的多步结果。",
      "B": "保持X、Y配对同时重排不会增加新数据，也没有检验模型预测后继续输入自身预测的过程。",
      "C": "每步真值会校正偏差，这一统计并不等于自主滚动时的误差。",
      "D": "新初值和连续使用自身预测同时检验了训练范围外的初态与随时间累积的误差。"
    }
  },
  "p14-null-direction": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "训练只限制算子在已见列空间上的作用。",
      "B": "对一个方向作用相同不能确定完整二维矩阵（matrix）。",
      "C": "设置秩不会增加数据的独立方向。",
      "D": "沿同一直线增加样本仍不激发缺失方向。"
    }
  },
  "p14-paired-columns": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "这把当前时刻x_j与一个采样（sampling）间隔后的x_(j+1)配在同一列。",
      "B": "这把当前时刻与上一个时刻配对，拟合的是向后一步的关系。",
      "C": "这把当前时刻与两个采样间隔后的值配对，不是一步传播。",
      "D": "X和Y使用同一时刻的值，会拟合保持状态（state）不变的映射。"
    }
  },
  "p14-dmd-rates": {
    "cases": [
      {
        "arguments": {
          "real": 0.0,
          "imag": 1.0,
          "dt": 0.5
        },
        "expected": [
          0.0,
          3.141592653589793
        ]
      },
      {
        "arguments": {
          "real": 0.8,
          "imag": 0.0,
          "dt": 1.0
        },
        "expected": [
          -0.2231435513142097,
          0.0
        ]
      },
      {
        "arguments": {
          "real": -1.0,
          "imag": 0.0,
          "dt": 2.0
        },
        "expected": [
          0.0,
          1.5707963267948966
        ]
      }
    ],
    "explanation": "首例幅度不变而相角为 π/2，所以衰减率为0，主值角频率为 π/T；整圈混叠仍可能存在。"
  },
  "p14-angle-alias": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "采样间隔为2T，角频率乘间隔得到0.5+2πk，因此离散相角相同。",
      "B": "当k为奇数时，每步增加π而非2π的整数倍，会得到不同相角。",
      "C": "每步相角为1+2πk，而题定相角为0.5。",
      "D": "这只列出了正确集合中k为偶数的频率，遗漏了其他整圈混叠（aliasing）频率。"
    }
  },
  "p14-eigen-modulus": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "遗漏了一步的乘法。",
      "B": "每步乘0.8，两步乘0.8²=0.64。",
      "C": "把每步乘0.8误作每步减去初始幅度的0.2。",
      "D": "把两次乘法误作相加。"
    }
  },
  "p14-local-operator": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "事后缩放会掩盖真实预测差异。",
      "B": "参与拟合后不再是原来的独立测试。",
      "C": "训练一步误差不能替代大幅多步评价。",
      "D": "振幅分层的独立评估能检验线性近似的适用范围。"
    }
  },
