  "p14-koopman-functions": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "g(x) 是标量，未必能作为状态规则 F 的输入，而且这颠倒了演化与观测的顺序。",
      "B": "从 x 更新到 F(x)，随后按同一个函数 g 观测，就是 (Kg)(x)=g(F(x))。",
      "C": "相加没有给出下一步的 g 值，标量观测与状态也未必具有同一维度。",
      "D": "乘积并没有按 F 更新之后再应用 g，不是这里的观测传播。"
    }
  },
  "p14-exact-closure": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "第三项是下一步 x 的平方，x 自身也应平方。",
      "B": "(ax)² 中 a 和 x 都被平方，不能只平方 x。",
      "C": "(x⁺)²=(ax)²=a²x²，因此仍是字典第三项的固定倍数。",
      "D": "这里计算平方值；求导时出现的因子 2 不能用于这项离散更新。"
    }
  },
  "p14-readout": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "z1 已等于 x，加上 z3 会额外加一个 x²。",
      "B": "第二个输出变成 x²，遗漏了 y。",
      "C": "这一对含 y、x²，却没有原来的 x。",
      "D": "按给定顺序，前两项正好是 x、y；取出它们即可还原原状态。"
    }
  },
