{
  "p09-normal-update": {
    "cases": [
      {
        "arguments": {
          "prior_mean": 0.0,
          "prior_variance": 4.0,
          "observations": [
            1.0,
            3.0
          ],
          "noise_variance": 2.0
        },
        "expected": [
          1.6,
          0.8,
          2.8
        ]
      },
      {
        "arguments": {
          "prior_mean": 3.0,
          "prior_variance": 2.0,
          "observations": [],
          "noise_variance": 1.0
        },
        "expected": [
          3.0,
          2.0,
          3.0
        ]
      },
      {
        "arguments": {
          "prior_mean": -1.0,
          "prior_variance": 0.5,
          "observations": [
            -2.0
          ],
          "noise_variance": 0.25
        },
        "expected": [
          -1.6666666666666665,
          0.16666666666666666,
          0.41666666666666663
        ]
      }
    ],
    "explanation": "精度为1/4+2/2=1.25，后验均值1.6、方差0.8；新读数还含2单位噪声方差，预测方差为2.8。"
  },
  "p09-likelihood-object": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "似然作为θ的函数通常不归一化。",
      "B": "数据固定，变量是参数（parameter）。",
      "C": "证据是先验乘似然的积分。",
      "D": "形式上相同但证据不同；没有第二次独立观测（observation）时平方会重复计数。"
    }
  },
  "p09-posterior-predictive": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "精度累积给出此极限。",
      "B": "观测（observation）随机性仍保留。",
      "C": "即使偏差参数已知，新读数仍带方差r的独立观测噪声。",
      "D": "漂移或相关误差会改变结论。"
    }
  },
  "p09-prior-vs-data": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "先验改变不会改变已观察数据的均值或仪器噪声。",
      "B": "数据精度未变，增加的是先验精度，因此数据相对权重下降。",
      "C": "除先验均值恰等于样本均值等特殊情形，权重改变也会移动后验均值。",
      "D": "缩小先验方差增加先验精度，使后验均值通常更靠近先验均值。"
    }
  },
  "p09-normalizer-zero": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "正而有限的证据使pL/Z非负且积分为1。",
      "B": "无穷积分不能通过除以Z得到合法概率密度。",
      "C": "证据为0时无法归一化，分母不能为0。",
      "D": "未归一化后验不必本来积分为1，只需正且有限。"
    }
  },
