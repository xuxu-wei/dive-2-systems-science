            0.9,
            0.3
          ],
          "separation": 0.0
        },
        "expected": [
          [
            0.0,
            1.0,
            1.0,
            -1.0
          ],
          [
            true,
            false,
            true
          ]
        ]
      },
      {
        "arguments": {
          "initial": 2.0,
          "candidates": [],
          "log_reverse_over_forward": [],
          "uniforms": [],
          "separation": 3.0
        },
        "expected": [
          [
            2.0
          ],
          []
        ]
      },
      {
        "arguments": {
          "initial": 0.0,
          "candidates": [
            1.0,
            0.0
          ],
          "log_reverse_over_forward": [
            -2.0,
            1.0
          ],
          "uniforms": [
            0.5,
            0.5
          ],
          "separation": 0.0
        },
        "expected": [
          [
            0.0,
            0.0,
            0.0
          ],
          [
            false,
            true
          ]
        ]
      },
      {
        "arguments": {
          "initial": -2.0,
          "candidates": [
            2.0,
            8.0
          ],
          "log_reverse_over_forward": [
            0.0,
            0.0
          ],
          "uniforms": [
            0.999,
            0.0
          ],
          "separation": 2.0
        },
        "expected": [
          [
            -2.0,
            2.0,
            8.0
          ],
          [
            true,
            true
          ]
        ]
      }
    ],
    "explanation": "第一步exp(−1/2)>.2故接受1；第二步概率exp(−7.5)<.9故保持1；第三步到−1密度相同故接受。轨迹为[0,1,1,−1]。"
  },
