{
  "p09-normal-update": {
    "cases": [
      {
        "arguments": {
          "prior_mean": 0.0,
          "prior_variance": 4.0,
          "observations": [
            1.0,
            3.0
          ],
          "noise_variance": 2.0
        },
        "expected": [
          1.6,
          0.8,
          2.8
        ]
      },
      {
        "arguments": {
          "prior_mean": 3.0,
          "prior_variance": 2.0,
          "observations": [],
          "noise_variance": 1.0
        },
        "expected": [
          3.0,
          2.0,
          3.0
        ]
      },
      {
        "arguments": {
          "prior_mean": -1.0,
          "prior_variance": 0.5,
          "observations": [
            -2.0
          ],
          "noise_variance": 0.25
        },
        "expected": [
          -1.6666666666666665,
          0.16666666666666666,
          0.41666666666666663
        ]
      }
    ],
    "explanation": "两次读数给出总精度1/4+2/2=1.25，后验方差为0.8 U²、均值为0.8×(1+3)/2=1.6 U。新读数方差另加2 U²，得到2.8 U²。"
  },
  "p09-likelihood-object": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "似然在这里是参数的函数，对θ没有积分为1的要求。",
      "B": "比较时读数固定，改变的是θ；连续读数使用密度。",
      "C": "正且有限的这个积分是证据，使后验归一化。",
      "D": "平方形式对应重复乘似然，但没有新读数便是在重复计算同一信息。"
    }
  },
  "p09-posterior-predictive": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "共同参数的后验精度随独立读数累积，方差可以趋近0。",
      "B": "预测方差为参数后验方差加r，参数部分缩小后仍保留新噪声。",
      "C": "即使共同偏差已知，单次未来读数仍有方差r的噪声。",
      "D": "偏差漂移或相关噪声会改变这里的精度累积关系。"
    }
  },
  "p09-prior-vs-data": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "先验变化没有改写已有读数，也没有改变仪器噪声。",
      "B": "增加的是先验精度，数据精度未变，数据的相对权重反而减小。",
      "C": "除两种均值重合等特殊情况，加权份额改变也会改变后验均值。",
      "D": "先验方差减小使其精度增加，因而在加权均值中占更大份额。"
    }
  },
  "p09-normalizer-zero": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "这样除以Z后，乘积非负且对参数积分为1。",
      "B": "无限积分不能通过这里的除法得到合法密度。",
      "C": "Z为0时分母没有定义，无法按此式归一化。",
      "D": "未归一化乘积可以有任意有限正积分，再除以它即可。"
    }
  },
