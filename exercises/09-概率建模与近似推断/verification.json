  "p09-proposal-ratio": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "从x提议y后，用逆向提出x的概率修正正向提议概率。",
      "B": "正反方向颠倒，详细平衡（detailed balance）需要反向提议除以前向提议。",
      "C": "两个方向应取比值，不是相乘。",
      "D": "接受比修正的是方向不对称，不是联合稀有程度。"
    }
  },
  "p09-stationary-vs-convergence": {
    "correct": [
      "B",
      "C",
      "D"
    ],
    "explanations": {
      "A": "P=I不改变当前状态，从确定初态出发会一直停在那里。",
      "B": "没有跨状态运动。",
      "C": "前篇马尔可夫链（Markov chain）条件仍需检查。",
      "D": "这是保证有限状态链长期收敛的一组充分条件。"
    }
  },
  "p09-rejections": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "遗漏拒绝停留时间，一般改变经验分布（distribution）。",
      "B": "停留时间是MH链分布的一部分，应纳入时间平均。",
      "C": "去重同样删除停留信息，不能一般表示目标概率质量（probability mass）。",
      "D": "被拒绝提议不是链该步状态，不能代替当前状态记录。"
    }
  },
