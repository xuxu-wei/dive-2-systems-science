  "p09-coordinate-map": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "少了密度变换因子。",
      "B": "dk/dη=expη。",
      "C": "密度相对于不同坐标体积定义。",
      "D": "应乘|dk/dη|=expη，而非其倒数。"
    }
  },
  "p09-single-mode": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "一个峰附近的曲率无法控制峰间及另一个峰的概率质量（probability mass）。",
      "B": "局部二阶近似只描述邻域，不自动覆盖远处模式。",
      "C": "还需其他峰的位置、高度和形状等信息，单峰曲率不足。",
      "D": "归一化只重分配局部近似质量，不能补充被遗漏的模式。"
    }
  },
  "p09-grid-domain": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "网格检查针对离散化。",
      "B": "区间内离散误差不能给出区间外截断质量的界。",
      "C": "区间和步长是不同误差来源。",
      "D": "边界峰需要重新选区间或检查真实支持。"
    }
  },
  "p09-mh-replay": {
    "cases": [
      {
        "arguments": {
          "initial": 0.0,
          "candidates": [
            1.0,
            4.0,
            -1.0
          ],
          "log_reverse_over_forward": [
            0.0,
            0.0,
            0.0
