  "p09-high-acceptance": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "高接受率可能来自步幅极小，不证明已经探索目标。",
      "B": "抽稀不能补充从未探索的区域，独立性也需另检验。",
      "C": "这些检查针对局部小步造成的缓慢探索及对初态的依赖。",
      "D": "更小步幅通常更难离开起点，接受率本身不是探索质量目标。"
    }
  },
  "p09-same-mode": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "链间一致可以共同出错。",
      "B": "独立参照与分散初值（initial condition）可暴露问题。",
      "C": "诊断来自已访问样本，所有链同困一峰时无法界定未访问峰的质量。",
      "D": "均值可能掩盖分布（distribution）结构。"
    }
  },
  "p09-ess-not-particles": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "MCMC相关性ESS还取决于时间自相关，不使用相同公式。",
      "B": "把两类ESS的作用方向颠倒。",
      "C": "两者名称相同但针对不同的信息损失机制。",
      "D": "这两类ESS都不等同于去重后的状态或祖先计数。"
    }
  },
  "p09-budget-repeat": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "预算保证比较条件透明。",
      "B": "重复刻画随机计算波动。",
      "C": "根据参考误差事后选择停止点会偏向偶然命中，并破坏预算对齐。",
      "D": "前者是计算误差，后者是模型（model）内不确定性。"
    }
  },
