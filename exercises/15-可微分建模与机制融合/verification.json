{
  "p15-graph-order": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "预测va+c依赖a，必须在激活后。",
      "B": "a=tanh(z)依赖已计算的z。",
      "C": "每一步依次为下一步提供输入（input）。",
      "D": "损失要使用预测，不能先于预测。"
    }
  },
  "p15-static-not-ode": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "静态网络未执行时间积分。",
      "B": "响应率不必为零，也没有平衡求解约定。",
      "C": "一次前向计算不等于生成整个时间序列（time series）。",
      "D": "输入（input）到响应率的函数还需与方程和求解器结合才能生成轨迹（trajectory）。"
    }
  },
  "p15-gradient-object": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "中心差分（central difference）核验给定程序在该处的参数导数（derivative）。",
      "B": "导数一致性不测量独立预测性能。",
      "C": "导数核验不保证优化到全局最优。",
      "D": "若图中含数值求解器，所查的是离散程序，不自动等于连续目标。"
    }
  },
  "p15-nonsmooth": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "左右导数不同，不能取平均定义通常导数。",
      "B": "仅使用左侧导数不能给出双侧导数。",
      "C": "仅使用右侧导数不能给出双侧导数。",
      "D": "左右极限（limit）分别为0和1，对称商为0.5并不改变导数不存在。"
    }
  },
  "p15-one-step-input": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "给出初值后，每一步只使用前一步预测，不再由后续真值纠正累积偏差。",
      "B": "每步都读真实状态得到的是一步预测（one-step-ahead prediction），不是自主连续预测。",
      "C": "隔步读取真值会周期性重置预测偏差，改变自由滚动的输入边界。",
      "D": "真实状态增量也是后续观测（observation），使用它会向预测过程提供新的真实信息。"
    }
  },
  "p15-sampling-object": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "下一状态值减半不等于把演化时间减半。",
      "B": "两次1T映射对应2T，而非0.5T。",
      "C": "一步映射依赖物理间隔，需检查新间隔对应的转移。",
      "D": "改标签没有改变原模型（model）代表的时间跨度。"
    }
  },
  "p15-split-trajectories": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "相邻点高度相关，未独立保留动态条件。",
      "B": "用于选择的留出不能同时作最终独立评估。",
      "C": "完整轨迹（trajectory）留出且不调参保留独立条件。",
      "D": "交错拆点仍使同一轨迹的邻近信息分散在两边。"
    }
  },
  "p15-rollout-leak": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "替换输入（input）不是改变时间步。",
      "B": "每步读取真实状态（state）会重置累积偏差。",
      "C": "真值改变实际预测输入，并非显示操作。",
      "D": "使用真值不改变网络结构。"
    }
  },
  "p15-two-gradients": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "题设Euler更新也在求导路径上。",
      "B": "有限步长目标一般不同于连续目标。",
      "C": "穿过完整求解程序会传播中间状态依赖。",
      "D": "自动微分（automatic differentiation，AD）沿实际执行的离散计算图（computational graph）求导。"
    }
  },
  "p15-sensitivity-initial": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "x0与k无关，对k求导为0。",
      "B": "状态（state）初值不等于参数（parameter）导数（derivative）。",
      "C": "这是某些清除方程的状态变化率，不是初值对k的导数。",
      "D": "若初值直接等于k，导数才为1；本题不是。"
    }
  },
  "p15-adjoint-jump": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "这是损失量级，尚未对状态（state）求导。",
      "B": "点观测（observation）损失不是时间积分项，跳跃不额外乘h。",
      "C": "按题定从右侧到左侧的伴随跳跃，贡献为正残差（residual）。",
      "D": "平方误差的一半对x求导得到残差（residual）。"
    }
  },
  "p15-reverse-state": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "Euler正反更新的乘子为1−hk与1+hk，并非互逆。",
      "B": "直接相乘得到该式，非零hk时一般不恢复原值。",
      "C": "乘积是两个平方之差1−h²k²。",
      "D": "反向时间步为−h，乘子应为1+hk。"
    }
  },
  "p15-network-value": {
