{
  "p15-graph-order": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "预测 ŷ=va+c 需要激活值 a，因此不能先于 a 计算。",
      "B": "a=tanh(z) 需要加权输入 z，因此应先求 z。",
      "C": "先由输入得到 z，再由 z 得到 a，随后得到预测；有了预测与目标的差，才能计算损失。",
      "D": "损失比较预测与目标，缺少预测值时还不能求出损失。"
    }
  },
  "p15-static-not-ode": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "这次计算只把一个输入映射为响应率，没有从初值出发进行时间积分。",
      "B": "求平衡状态需要检查变化率为零等条件，一次响应率计算没有完成这项工作。",
      "C": "一次前向计算返回一个响应率，各时刻的状态仍需通过时间推进得到。",
      "D": "网络给出当前输入处的响应。把这个响应放入状态变化方程后，初值和求解过程才能共同确定轨迹。"
    }
  },
  "p15-gradient-object": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "中心差分逐个扰动参数并重新计算同一个程序的损失；两者吻合支持这里的局部导数实现。",
      "B": "导数核对没有比较新初值下的预测与真值，预测误差需要另行计算。",
      "C": "某处导数计算正确，不能据此判断该处是不是全局最小点。",
      "D": "如果前向计算包含数值求解器，差分和反向传播核对的都是该求解程序的目标；连续方程的目标需要另外核验。"
    }
  },
  "p15-nonsmooth": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "通常的导数要求左右差商趋于同一个值，不能用两侧斜率的平均代替这个条件。",
      "B": "左侧差商趋于 0，右侧却趋于 1，只知道左侧还不足以确定双侧导数。",
      "C": "右侧差商趋于 1，左侧却趋于 0，只知道右侧还不足以确定双侧导数。",
      "D": "左右导数不同，因此双侧导数不存在。对称取点给出的 0.5 不会改变这一事实。"
    }
  },
  "p15-one-step-input": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "自由滚动从初值出发，后续状态由模型自身递推；已知外部输入仍按给定序列提供。",
      "B": "每次都提供真实当前状态，测得的是一系列一步预测误差，累积偏差被不断重置。",
      "C": "隔步提供真实状态会周期性校正路径，因此改变了自由滚动的预测任务。",
      "D": "真实变化量包含后续观测信息，用它校正状态也会改变原定的自由滚动任务。"
    }
  },
  "p15-sampling-object": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "状态值减半和演化时间减半是不同操作，例如指数衰减的半时状态由半时指数决定。",
      "B": "在原定条件下连续运行两次 1 T 映射对应 2 T 的推进。",
      "C": "下一状态映射包含采样间隔的信息，新的时间间隔需要对应的转移关系及验证。",
      "D": "改写时间标签没有改变原映射计算出的状态，也没有改变它所对应的演化时长。"
    }
  },
  "p15-split-trajectories": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "训练和测试共享同一轨迹的邻近信息，无法充分检验完整新轨迹上的预测。",
      "B": "留出轨迹一旦用于选参，最终模型就已经利用了这些轨迹的信息，不能再把它们称为独立测试。",
      "C": "整条轨迹留出且不参与选参，保留了最终评估所需的新轨迹信息。",
      "D": "交错拆分仍把相邻信息分散在训练和测试两边，首尾相接还不能消除这一问题。"
    }
  },
  "p15-rollout-leak": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "替换当前状态没有改变一步映射所对应的时间间隔。",
      "B": "每一步都获得新的真实状态，上一步偏差不会完整传入下一步，因此这条曲线不能代替自由滚动评估。",
      "C": "被替换的状态实际参与了下一次计算，因此改变了预测过程。",
      "D": "替换输入值没有改变网络的层数或参数结构。"
    }
  },
  "p15-two-gradients": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "每次更新都在计算图内，参数经由更新影响后续状态的导数也会传递。",
      "B": "有限步长的数值状态一般不同于连续解，因而两者构成的目标及导数一般不同。",
      "C": "完整计算图包含前后状态的依赖，自动微分会沿这些依赖传播导数。",
      "D": "前向计算得到的是 Euler 状态，反向计算因此求 J_h 的梯度；可用步长细化比较它与连续目标梯度的差。"
    }
  },
  "p15-sensitivity-initial": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "s(0)=∂x₀/∂k。改变 k 不改变固定初值，所以这个导数为零。",
      "B": "状态的初值和状态对参数的导数是不同的量。",
      "C": "−kx₀ 是清除方程在初始时刻的时间变化率，本题求的是对 k 的导数。",
      "D": "若初值本身等于 k，这个导数才是 1；题设的初值固定。"
    }
  },
  "p15-adjoint-jump": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "误差平方还没有对状态求导，跳跃需要的是损失的状态导数。",
      "B": "这里损失在观测点逐项相加，未作时间积分，所以跳跃没有额外的步长因子。",
      "C": "按题设从观测后向观测前更新的约定，应加上损失对状态的导数，而不是它的相反数。",
      "D": "对 (1/2)[x(tⱼ)−yⱼ]² 关于 x(tⱼ) 求导，得到残差 x(tⱼ)−yⱼ。"
    }
  },
  "p15-reverse-state": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "前进乘 1−hk，回退乘 1+hk，后者不是前者的倒数。",
      "B": "两次更新得到 (1+hk)(1−hk)x=(1−h²k²)x。当 x≠0 时，这不同于原状态。",
      "C": "两个乘子相乘是平方差 1−h²k²，符号应为减号。",
      "D": "回退采用时间步 −h，Euler 更新中的乘子因此是 1+hk。"
    }
  },
