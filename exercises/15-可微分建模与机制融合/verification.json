{
  "p15-graph-order": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "激活函数接受 z 作为输入（input）。",
      "B": "损失依赖最终预测。",
      "C": "前向值尚未得到。",
      "D": "留出答案不能参与前向计算。"
    }
  },
  "p15-static-not-ode": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "尚未声明状态方程和积分规则。",
      "B": "函数值和动态轨迹是不同对象。",
      "C": "普通网络不带该结构约束。",
      "D": "拟合参数未必有机制可辨识性（identifiability）。"
    }
  },
  "p15-gradient-object": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "只能核验当前程序的局部导数。",
      "B": "梯度（gradient）核验不是独立预测。",
      "C": "中心差分（central difference）是对给定程序的独立局部检查。",
      "D": "导数正确不保证优化成功。"
    }
  },
  "p15-nonsmooth": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "左右导数不相等，双侧导数不存在。",
      "B": "它是跨越折点的对称商。",
      "C": "可采用明确的次梯度（subgradient）约定。",
      "D": "跨越折点的差分不代表存在导数。"
    }
  },
  "p15-one-step-input": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "两种输入（input）边界不同。",
      "B": "同一权重并不等于同一预测协议。",
      "C": "可视化不能消除真值泄漏。",
      "D": "固定间隔仍有输入边界差异。"
    }
  },
  "p15-sampling-object": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "映射输出是下一步状态（state）。",
      "B": "离散转移依赖采样间隔。",
      "C": "时间轴缩放不改变模型（model）参数（parameter）。",
      "D": "间隔决定一步的物理意义。"
    }
  },
  "p15-split-trajectories": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "相邻点共享动态条件。",
      "B": "评估参与选择。",
      "C": "完整轨迹保留独立条件。",
      "D": "仍可能高度相关。"
    }
  },
  "p15-rollout-leak": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "它改变了评估信息。",
      "B": "真值反馈（feedback）可掩盖漂移。",
      "C": "自由滚动不使用未来真值。",
      "D": "后续输入已被真实轨迹（trajectory）替代。"
    }
  },
  "p15-two-gradients": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "先明确被求导的对象。",
      "B": "有限步长求解引入误差。",
      "C": "Euler 更新显式包含 h。",
      "D": "确定性程序可直接微分。"
    }
  },
  "p15-sensitivity-initial": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "状态（state）初值不等于对参数（parameter）的导数（derivative）。",
      "B": "固定初态对 k 求导为零。",
      "C": "这是状态变化率而非初始灵敏度。",
      "D": "光滑例中可以定义。"
    }
  },
  "p15-adjoint-jump": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "离散观测正产生跳跃。",
      "B": "点观测跳跃本身不乘 h。",
      "C": "这是对状态（state）的观测损失导数（derivative）。",
      "D": "会丢掉观测贡献。"
    }
  },
  "p15-reverse-state": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "正反两个 Euler 更新并非互逆。",
      "B": "稳定前向常伴随反向误差放大。",
      "C": "离散方法本身也有误差。",
      "D": "数值重建与伴随推导属于不同层次。"
    }
  },
