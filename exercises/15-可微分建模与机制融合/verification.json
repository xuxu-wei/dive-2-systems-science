  "p15-pinn-parts": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "数据损失比较数值，不直接检查导数（derivative）残差（residual）。",
      "B": "给定点上的误差小直接表示与这些读数接近。",
      "C": "初始时刻若未纳入该项，不能由它推出初值（initial condition）正确。",
      "D": "有限观测（observation）点拟合不约束全部时刻。"
    }
  },
  "p15-loss-unit": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "数值平均仍混合不同单位；改变时间单位会改变两个分项的相对大小。",
      "B": "样本数没有单位，除以样本数不会消除U²与U²/T²的差别。",
      "C": "方程残差平方乘一个时间尺度（time scale）后为U²/T，还不能与U²相加。",
      "D": "两项分别除以具有相同单位的参考平方量后均无量纲（dimensionless），再用权重规定两者在拟合中的相对影响。"
    }
  },
  "p15-boundary-needed": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "cos项端点导数为零，但sx的导数为s。",
      "B": "线性x项二阶导数（second derivative）为零，不产生内部残差；端点却不满足。",
      "C": "sx时间导数与二阶空间导数都为零，端点一阶导数为s。",
      "D": "内部残差不是s；s来自一阶空间导数。"
    }
  },
  "p15-collocation-limit": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "重复计算同一批配点不增加时空覆盖，不能检验配点之外的方程残差。",
      "B": "不同分项可能因权重或尺度被其他项掩盖，总损失小不代表每项都小。",
      "C": "独立位置的残差、边界条件与参考解误差提供不同核验，可发现训练配点未覆盖的问题。",
      "D": "损失下降很多仍可能留下较大误差，需要查看最终残差和解误差。"
    }
  },
  "p15-zero-correction": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "θ=0使θtanh(x/s)消失，保留机制基线。",
      "B": "关闭修正后输入（input）仍在。",
      "C": "只关闭θ项，不会关闭整个右端。",
      "D": "关闭修正后清除项仍在。"
    }
  },
  "p15-mechanism-claim": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "独立预测支持指定条件下的表现，机制身份还需辨识与额外证据。",
      "B": "一个修正函数可能代理多种遗漏过程。",
      "C": "预测好并不排除不同参数（parameter）组合产生相同轨迹（trajectory）。",
      "D": "修正本身可能吸收遗漏变量作用。"
    }
  },
  "p15-confounding-input": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "所有已知输入（input）下仍只出现参数差，输入丰富不破坏等价性。",
      "B": "数值精度不创造新的参数依赖。",
      "C": "更多同类读数不改变参数组合的结构。",
      "D": "同时给k、θ加同一常数不改变方程，单看x不能区分。"
    }
  },
  "p15-candidate-variance": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "加权候选方差描述所列预测之间的差异。",
      "B": "题中计算未独立识别测量噪声（measurement noise）。",
      "C": "两组预设参数（parameter）未覆盖所有结构，也未给出后验（posterior）推断。",
      "D": "这里改变的是候选，而非同一候选的随机实现。"
    }
  },
