{
  "p16-lyapunov-actual": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "实际输入（input）决定当前状态（state）变化率。",
      "B": "对导数（derivative）限幅不等于对控制输入限幅。",
      "C": "执行器没有施加二者均值。",
      "D": "无延迟（delay）题设下，上一时刻输入不能替代当前输入。"
    }
  },
  "p16-cubic-condition": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "β−c≤0等价于c≥β。",
      "B": "c<β的部分使β−c为正，四次项增加V。",
      "C": "β>0时此范围使β−c为正。",
      "D": "该范围仍使四次系数为正。"
    }
  },
  "p16-saturated-global": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "直接证据来自题定模型（model）、初值与模拟窗口。",
      "B": "一条轨迹（trajectory）不能确定其他状态（state）的限幅情况。",
      "C": "大扰动可能要求超过执行能力的输入（input）。",
      "D": "限幅改变控制律，不能把未限幅导数原样外推。"
    }
  },
  "p16-finite-scan": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "有限间距没有排除未采到的边界或不稳定区域。",
      "B": "数值证据覆盖实际扫描条件，区域结论需要额外约束。",
      "C": "轨迹（trajectory）观察不等价于对全域导数（derivative）的不等式证明。",
      "D": "相同控制律可在大扰动处触发饱和或失稳。"
    }
  },
  "p16-common-p": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "坐标变化后仍需统一度量，不能直接拼接。",
      "B": "每个P可能只适合自己的顶点，平均不自动适合全部。",
      "C": "分别存在的量词不能交换为共同存在。",
      "D": "AᵀP+PA在P固定时随A仿射（affine）变化。"
    }
  },
  "p16-vertex-scope": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "参数在区间内不等于矩阵处于已验证凸包。",
      "B": "抽样点没有覆盖完整集合的保证。",
      "C": "不同P的证书不能按原凸组合推导直接合并。",
      "D": "固定P下导数（derivative）矩阵随A仿射（affine），凸组合保持负定。"
    }
  },
  "p16-certificate-failure": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "失败针对当前候选，不能排除其他证书。",
      "B": "正倍数缩放不改变二次型符号。",
      "C": "一个二次函数未严格下降不等于状态（state）必发散。",
      "D": "候选P与A固定时，矩阵不随仿真时长变化。"
    }
  },
  "p16-outside-set": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "扩大集合需要重新验证，新点不自动被旧证书覆盖。",
      "B": "反例不在原声明集合内，未反驳原命题。",
      "C": "集合内证书不改变外部矩阵（matrix）的特征值（eigenvalue）。",
      "D": "声明范围与反例范围不同，应分开陈述。"
    }
  },
  "p16-zero-excitation": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "没有回归量就没有参数校正项。",
      "B": "RLS增益（gain）含φ，φ=0时为0；P可更新为P/λ。",
      "C": "观测（observation）残差（residual）还需乘增益，增益为零。",
      "D": "零回归量没有提供真值信息。"
    }
  },
  "p16-rls-order": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "新估计尚未得到，用它定义本轮创新会改变递推。",
      "B": "未来观测在本轮不可用。",
      "C": "用当前观测（observation）与旧估计预测相减形成残差（residual）。",
      "D": "回归量与观测角色颠倒，通常量纲（dimension）也不匹配。"
    }
  },
  "p16-no-lookahead": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "选择本轮动作时，这个未来状态（state）还没有发生，读取它会使用未来信息。",
      "B": "a_hat_n来自本轮之前的观测（observation）和更新，选择动作时已经可用。",
      "C": "x_n是题定当前观测，可以作为本轮控制的输入（input）。",
      "D": "执行器上限是事先给定的约束，可以在选动作时使用。"
    }
  },
  "p16-tracking-not-id": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "良好反馈（feedback）补偿不等于参数（parameter）正确。",
      "B": "跟踪好与参数偏差可以同时存在。",
      "C": "更强反馈可能使状态（state）变化更小，未必增加辨识激励。",
      "D": "跟踪测任务输出（output），辨识还受可用信息与激励约束。"
    }
  },
  "p16-brownian-scale": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "hZ的方差（variance）是h²，不是布朗增量所需的h。",
      "B": "标准正态Z的方差为1，乘sqrt(h)后方差为h。",
      "C": "Z/h的方差为1/h²，时间区间缩短时反而增大。",
      "D": "固定值h没有随机波动，其方差为0。"
    }
  },
  "p16-paired-refine": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "边缘分布（distribution）虽可匹配，却不是同一路径。",
      "B": "均值的方差与区间总增量不符。",
      "C": "布朗路径在相邻区间上的增量可相加。",
      "D": "重复同一增量改变相关性及方差（variance）。"
    }
  },
  "p16-mean-risk": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "均值不能代替逐次越界事件（event）计数。",
      "B": "0.98与1的差不是越界概率（probability）。",
      "C": "超出幅度和越界频率是不同指标。",
      "D": "20/200=10%，这是该批试验的经验违约率。"
    }
  },
  "p16-strong-weak": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "均值差会发生抵消，不是每条路径误差。",
      "B": "两类比较对象被对调。",
      "C": "路径误差可很大而均值差很小。",
      "D": "同路径差与期望（expectation）等统计差回答不同问题。"
    }
  },
  "p16-symmetric-average": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "全体和的变化为−h1ᵀLx，对称图列和为零。",
      "B": "L1=0说明一致状态（state）不变，不说明任意x不变。",
      "C": "非空无向图的拉普拉斯迹一般为正，迹也不是总量条件。",
      "D": "平均守恒来自列和，不要求特征值（eigenvalue）相等。"
    }
  },
  "p16-disconnected": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "分量间无边，无法交换信息以达全网均值。",
      "B": "对称线性一致性保留平均，不选最大值。",
      "C": "每个连通分量（connected component）内独立守恒并达成一致。",
      "D": "分量内可通过耦合改变个体状态（state）。"
    }
  },
  "p16-delay-formula": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "用hLx_n计算耦合会去掉题设的历史延迟（delay）。",
      "B": "题设更新从当前x_n出发；改从x_(n−d)出发会改变差分方程（difference equation）。",
      "C": "当前状态（state）减去由历史状态算出的耦合增量，正是给定公式。",
      "D": "x_(n+1)是待求结果，题设没有要求读取它来计算这一显式更新。"
    }
  },
  "p16-delay-condition": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "守恒模态不代表其他模态稳定，无延迟乘子不能直接沿用。",
      "B": "延迟引入历史状态（state），特征方程与d=0不同。",
      "C": "一种初始历史不能建立对所有扰动的稳定结论。",
      "D": "图谱为实数也不消除时间递推的延迟项。"
    }
  },
  "p16-terminal-reward": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "这是从下一步起每步单位奖励时的回报。",
      "B": "之后每步奖励都为0，折扣和为0。",
      "C": "这是从本步起每步单位奖励时的回报。",
      "D": "折扣因子本身不是奖励。"
    }
  },
  "p16-policy-vs-learning": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "随机轨迹（trajectory）回报可不同，价值对其取期望。",
      "B": "最大回报对应最优价值，不是任意固定策略评价。",
      "C": "Vπ通过给定策略与模型（model）定义的回报期望给出。",
      "D": "Vπ包含未来奖励，而非只有即时期望。"
    }
  },
  "p16-terminal-q": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "终止后没有继续回报，但本步发生的奖励r仍应计入更新目标。",
      "B": "设为零会丢掉本步实际获得的奖励r。",
      "C": "终止标记表示不再延续，因此不加下一状态（state）的价值估计。",
      "D": "这次更新使用当前经验的奖励和终止信息，不是整批训练集（training set）的平均回报。"
    }
  },
  "p16-finite-q-claim": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "有限训练的观察不替代理论前提与独立评估。",
      "B": "渐近理论通常需要具体步长序列条件，非零本身不够。",
      "C": "奖励正负不确定策略是否最优。",
      "D": "未访问的表项也不变化，平稳外观不能证明覆盖。"
    }
  },
  "p16-pred-vs-actual": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "动作限制只约束输入（input），状态（state）还随真实参数（parameter）和当前状态变化。",
      "B": "将预测误差的最大可能偏差纳入检查，才能判断实际状态是否仍被限制在区间内。",
      "C": "最小化目标误差与动作惩罚并不能消除模型（model）参数偏差。",
      "D": "所有候选共享同一个有偏模型时，预测均可行仍可能对应实际越界。"
    }
  },
  "p16-infeasible-action": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "候选代价较低不等于满足原约束。",
      "B": "求解失败与备用控制是两个事实，需分别记录。",
      "C": "放宽约束改变了原问题。",
      "D": "零输入（input）也可能导致状态（state）越界。"
    }
  },
  "p16-paired-budget": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "不同成功子集破坏配对，可能隐藏失败代价。",
      "B": "按结果挑场景产生选择偏差。",
      "C": "各自不同初态混入任务难度差异。",
      "D": "完整配对记录保留表现、执行和失败证据。"
    }
  },
  "p16-rmse-not-safety": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "预测均方根误差（root mean squared error，RMSE）不能替代约束与失败评价。",
      "B": "按候选成功选择共同子集会偏置比较。",
      "C": "低预测误差与较高决策风险可同时存在。",
      "D": "不同量纲（dimension）与意义的指标不能无依据相减。"
    }
  },
