{
  "p16-lyapunov-actual": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "先将本次请求限幅，再代入状态方程得到实际变化率，最后用 $\\dot V=x\\dot x$ 求导。",
      "B": "执行上限约束控制输入。直接裁剪 V 的导数改变了检查对象，也没有得到实际状态变化率。",
      "C": "执行器施加的是限幅后的输入，没有施加请求与实际值的平均。",
      "D": "本题没有输入延迟，当前方程使用本次实际输入，不能换成上一次输入。"
    }
  },
  "p16-cubic-condition": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "$x^4\\ge0$，使其系数 $\\beta-c\\le0$ 的范围正是 $c\\ge\\beta$。",
      "B": "该范围包含 $c<\\beta$，此时四次项系数为正，会增加 V。",
      "C": "由于 $\\beta>0$，$c\\le-\\beta$ 会使 $\\beta-c>0$。",
      "D": "当 $0<c<\\beta$ 时，四次项系数仍为正，不能满足题目要求。"
    }
  },
  "p16-saturated-global": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "观察对应这一初值、模型和模拟条件，不能自动扩大到其他初值。",
      "B": "小偏差的请求可能没有触及上限，大偏差的请求仍可能触及它。",
      "C": "从一个初值恢复没有排除大偏差向外增长的情形。",
      "D": "限幅可能改变实际输入和 V 的导数；一条恢复曲线没有证明所有状态处导数相同。"
    }
  },
  "p16-finite-scan": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "有限间距未排除取样点之间的边界或失稳区域。",
      "B": "结果先对应实际计算过的条件，连续区域的结论需要额外分析。",
      "C": "若干路径的变化不能替代对全部非零状态求导并证明符号。",
      "D": "相同请求规则在大偏差处可能触发限幅，实际反馈效果仍会改变。"
    }
  },
  "p16-common-p": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "不同坐标系中的二次型需要先转到同一坐标与同一度量，不能直接拼接不等式。",
      "B": "每个 P 可能只适合一个顶点，它们的平均值需要重新检查，不能自动作为共同证书。",
      "C": "每个顶点分别存在一个 P，没有证明存在一个同时适合全部顶点的 P。",
      "D": "固定同一个 P 后，$A^\\mathsf TP+PA$ 随 A 作相同凸组合，负定端点才能用于这一步推导。"
    }
  },
  "p16-vertex-scope": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "参数在端点之间，不代表矩阵一定按所给顶点作凸组合；非线性参数关系需要另查。",
      "B": "有限抽样没有定义并覆盖所有允许矩阵，不能代替集合关系。",
      "C": "用不同 P 所得的不等式不能按题目的固定 P 推导合并。",
      "D": "每个允许矩阵都在已检顶点凸包内时，其导数矩阵是相同权重的负定矩阵组合。"
    }
  },
  "p16-certificate-failure": {
    "correct": [
