{
  "p17-c1s1-choice1": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "使用真值导数（derivative）没有检验带噪差分的困难。",
      "B": "短窗口未覆盖长期误差，混沌（chaos）还会放大偏差。",
      "C": "更大字典改变共线关系与选择问题，需要另作实验。",
      "D": "已知方程提供系数参考，可核对当前字典与窗口内的恢复。"
    }
  },
  "p17-c1s1-choice2": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "真值导数不消除候选列间的相关性。",
      "B": "阈值仍参与稀疏选择。",
      "C": "直接用方程算导数，绕过了从带噪观测（observation）估导数的环节。",
      "D": "新初值（initial condition）的泛化任务仍需独立测试。"
    }
  },
  "p17-c1s2-choice1": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "课程直接核验二维向量场、伴随跳跃和梯度（gradient）。",
      "B": "固定网格没有检验自适应求解配置。",
      "C": "课程未实现潜变量编码器。",
      "D": "低维简化未覆盖原文完整模型（model）和评估表。"
    }
  },
  "p17-c1s2-choice2": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "跳跃加入损失对状态的导数（derivative），不是损失数值。",
      "B": "点损失的状态梯度g作为加性贡献进入伴随变量。",
      "C": "点观测损失不是连续时间积分项，跳跃不额外乘步长h。",
      "D": "把伴随重置为g会丢掉由后续观测传回的λ(tj+)。"
    }
  },
  "p17-c2s1-choice1": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "该轨迹（trajectory）参与模型（model）选择后，不是最终独立测试。",
      "B": "相邻点仍来自同一动态条件。",
      "C": "完整新初态隔离可检验未用于训练和选择的条件。",
      "D": "按结果选测试轨迹产生选择偏差。"
    }
  },
  "p17-c2s1-choice2": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "重拟合在保留支持上进行，不自动恢复被删除列。",
      "B": "观测（observation）目标固定，不应为改善拟合任意改变。",
      "C": "重拟合是重新求最小二乘解，不是统一缩放。",
      "D": "删列改变最小二乘问题，剩余系数应重新估计。"
    }
  },
  "p17-c2s2-choice1": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "真实系数是额外信息，需要另设明确的信息预算。",
      "B": "共同任务加透明先验（prior）记录，才能解释方法差异。",
      "C": "测试参与选择会使候选评价偏乐观。",
      "D": "不同测试时域可能改变任务难度。"
    }
  },
  "p17-c2s2-choice2": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "差分是独立局部核验，支持当前条件下的梯度计算。",
      "B": "其他求解设置仍可能改变离散和重建误差。",
      "C": "梯度（gradient）正确不保证优化位置最优。",
      "D": "梯度核验没有比较独立预测误差。"
    }
  },
  "p17-c3s1-choice1": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "同时改变两项不能隔离稀疏选择。",
      "B": "测试条件同时变化会混淆表现来源。",
      "C": "按结果选择种子混入选择偏差。",
      "D": "保持其余条件相同，阈值差异对应稀疏程度的变化。"
    }
  },
  "p17-c3s1-choice2": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "实验改变的是导数（derivative）标签，结论应绑定所设噪声和样本。",
      "B": "直接给导数加噪声与给状态加噪后差分是不同噪声路径。",
      "C": "加噪并不解除候选列共线。",
      "D": "重复能量化波动，不能单独提供机制因果证据。"
    }
  },
  "p17-c3s2-choice1": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "时间步减小时梯度（gradient）趋于一致，是数值计算的检查；它没有计算另一初值（initial condition）上的预测误差。",
      "B": "增加求解器内部积分点不等于已经测得新初值误差下降。",
      "C": "求解器内部生成的积分点不是新的独立观测（observation），不能替代留出数据。",
      "D": "数值计算稳定并不说明所选方程结构能解释真实数据，仍需与基线比较预测。"
    }
  },
  "p17-c3s2-choice2": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "参数（parameter）数目不能直接换算真实测试误差。",
      "B": "并列两类误差与基线可检查额外自由度（degrees of freedom）是否有预测收益。",
      "C": "训练拟合不测新初态泛化。",
      "D": "各自挑初态会改变任务并产生选择偏差。"
    }
  },
  "p17-c4s1-choice1": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "室1的−q和室2的+q相加为零，不能把两项都记成流入。",
      "B": "交换只是两室之间转移，不能把它在两室都记成向系统外流出。",
      "C": "两室交换项相消，所以总量变化只剩外部输入（input）减去清除。",
      "D": "外部输入与清除未必相等，因此总量变化率未必为零。"
    }
  },
  "p17-c4s1-choice2": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "生成对象已经由Lorenz换为双室，并非只改采样（sampling）。",
      "B": "改动超出了求解器实现，包含新的系统任务。",
      "C": "训练生成过程也变了，不是只改字典。",
      "D": "方法思想沿用，但系统、方程与评价条件发生了变化。"
    }
  },
  "p17-c4s2-choice1": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "截断改变预测器，应分开报告原结果和后处理结果。",
      "B": "删除失败条件产生选择偏差。",
      "C": "翻正也是未声明后处理，不能代表原预测。",
      "D": "预测均方根误差（root mean squared error，RMSE）和物理约束测量不同方面，需同时保留。"
    }
  },
  "p17-c4s2-choice2": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "观测通道变化可能改变可辨识性（identifiability），未被当前实验检验。",
      "B": "范围外输入（input）可能暴露未建模结构。",
      "C": "误差随预测时域累积，短时排序不能直接外推。",
      "D": "这是给定比较直接支持的条件性结论。"
    }
  },
