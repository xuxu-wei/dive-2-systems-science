  "p17-c4s1-choice1": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "同一转移分别使一室减少、一室增加，不能把两项都当成增加。",
      "B": "转入第二室的量仍在系统内，不能在整体上重复扣除。",
      "C": "−q 与 +q 相消，整体只留下外部进入与清除的收支。",
      "D": "只有总输入与总清除相等时，这一变化率才为零。"
    }
  },
