  "p05-seed-repeats": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "重新创建生成器没有改变种子；每轮从同一数列的开头抽取，所得记录相同。",
      "B": "相同生成器和种子重复给出同一段数列，这些组不能反映独立重抽时的波动。",
      "C": "均值相同来自重复使用同一批数，不能据此判断生成规则的总体方差为零。",
      "D": "重复次数虽为 200，组内数据却未重新独立抽取，因而无法估计所需的组均值波动。"
    }
  },
  "p05-repeat-band": {
    "correct": [
      "A",
      "B",
      "C"
    ],
    "explanations": {
      "A": "独立二值频率的方差为 p(1−p)/n；n 增大可缩小其典型波动，但单次抽样仍可能偏得更远。",
      "B": "新一批重复会得到不同的组频率，排序后的分位端点也可能改变。",
      "C": "该范围由本批 200 个频率排序得到，描述其中间约 90% 的频率取值。",
      "D": "这里取分位数的对象是重复实验的样本频率，并没有构造对未知概率的置信区间。"
    }
  },
  "p05-shared-environment": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "每组改变 p，会把组间概率差异混入固定 p 下的抽样波动。",
      "B": "复制一个标签会使组内观察共享同一结果，并非 100 次独立选择。",
      "C": "相同种子每轮重置会重复同一随机数列，不能提供独立重抽的组结果。",
      "D": "各标签使用同一固定概率，重复实验另用随机流，才能比较该概率下的独立抽样波动。"
    }
  },
