  "p05-uncorrelated": {
    "correct": [
      "B",
      "C",
      "D"
    ],
    "explanations": {
      "A": "Y 由 X 完全决定；例如知道 Y=0 就排除了 X=−1、1，因此两者不独立。",
      "B": "只有 X=0 才有 X²=0，所以此条件下 X 确定为零。",
      "C": "协方差衡量中心偏差乘积的平均；左右对称可使它为零，同时保留平方关系。",
      "D": "E[X]=0、E[XY]=E[X³]=0，因此 Cov(X,Y)=E[XY]−E[X]E[Y]=0。"
    }
  },
  "p05-sum-variance": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "和的方差需加两倍协方差，1+4+2×1 应为 7。",
      "B": "本题求和，协方差项取正号，不能按相减的公式计算。",
      "C": "Var(X+Y)=Var(X)+Var(Y)+2Cov(X,Y)=1+4+2=7。",
      "D": "5 忽略了协方差；题设两个通道的中心变化并非零协方差。"
    }
  },
