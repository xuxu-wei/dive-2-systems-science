          "max_trials": 1
        },
        "expected": [
          [
            1.0
          ],
          null,
          "line_search_failed"
        ]
      },
      {
        "arguments": {
          "matrix": [
            [
              2.0
            ]
          ],
          "linear": [
            0.0
          ],
          "point": [
            1.0
          ],
          "direction": [
            -2.0
          ],
          "initial_step": 1.0,
          "shrink": 0.5,
          "slope": 0.1,
          "max_trials": 0
        },
        "expected": [
          [
            1.0
          ],
          null,
          "line_search_failed"
        ]
      },
      {
        "arguments": {
          "matrix": [
            [
              1.0
            ]
          ],
          "linear": [
            0.0
          ],
          "point": [
            0.0
          ],
          "direction": [
            0.0
