  "p08-step-limit": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "误差因子为1−ηλ，两个绝对值都须小于1。",
      "B": "η=.2时快方向因子−1，持续振荡。",
      "C": "快方向限制更严格。",
      "D": "该范围足够但不是题目所求的完整范围；例如η=0.15也收敛。"
    }
  },
  "p08-conditioning": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "该方向衰减慢。",
      "B": "η<2/λmax。",
      "C": "条件数是λmax/λmin。",
      "D": "ηH与ηb不变，递推相同。"
    }
  },
  "p08-small-gradient": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "最小点是0。",
      "B": "梯度为Hx；弱曲率方向的距离是梯度除以0.001，本例为1。",
      "C": "g=H(x−x*)且‖He‖≥μ‖e‖。",
      "D": "梯度依赖变量尺度。"
    }
  },
  "p08-newton-direction": {
    "cases": [
      {
        "arguments": {
          "point": 0.2
        },
        "expected": [
          0.192,
          "gradient_fallback"
        ]
      },
      {
        "arguments": {
          "point": 2.0
        },
        "expected": [
          -0.5454545454545454,
          "newton"
        ]
      },
      {
        "arguments": {
          "point": 0.0
        },
        "expected": [
          0.0,
          "stationary"
        ]
      },
      {
        "arguments": {
          "point": -1.0
        },
        "expected": [
          0.0,
          "stationary"
        ]
      },
      {
        "arguments": {
          "point": -0.5
        },
        "expected": [
          -0.375,
          "gradient_fallback"
        ]
      }
    ],
    "explanation": "x=.2时g=−.192，h=−.88；原始牛顿方向会向上，改用−g=.192。"
  },
  "p08-newton-taylor": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "对p求导并置零。",
      "B": "一般非二次目标还有高阶余项，全步可能过大，需进一步检验。",
      "C": "正定性（positive definiteness）给出下降方向。",
      "D": "二次展开无截断余项。"
    }
  },
  "p08-negative-curvature": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "缩小正步长不改变g·p的符号，上升方向的一阶项仍为正。",
      "B": "此处g=−0.192、H=−0.88，牛顿方向约−0.218，g·p>0；−g给下降。",
      "C": "改写检验公式不改变实际方向的一阶变化，不能代替方向修正。",
      "D": "正比例归一化仍保留上升方向，且全步还需下降检验。"
    }
  },
  "p08-stationary-stop": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "梯度确为0。",
      "B": "此处二阶导数（second derivative）为−1，实际是严格局部最大点。",
      "C": "可据此判定局部最大。",
      "D": "对非凸目标尤其重要。"
    }
  },
