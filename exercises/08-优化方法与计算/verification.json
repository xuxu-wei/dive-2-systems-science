  "p08-stationary-counterexample": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "一阶导数为零只识别驻点，原点的负曲率表明它是局部最大点。",
      "B": "f″(0)=−1，向任一侧足够小的移动都会降低目标。",
      "C": "配方f=(x²−1)²/4−1/4，平方非负且在±1归零，所以两点都达到全局下界。",
      "D": "负曲率给出局部结论；|x|增大时四次项使函数趋于正无穷。"
    }
  },
  "p08-hessian-zero": {
    "correct": [
      "B",
      "C",
      "D"
    ],
    "explanations": {
      "A": "二阶项为零时可能无法判断，−x⁴在原点就是最大而非最小。",
      "B": "x⁴始终非负，且仅在x=0取零。",
      "C": "−x⁴始终非正，且仅在x=0取零。",
      "D": "−x⁴在原点的海森矩阵为零，属于半正定，却是严格最大点。"
    }
  },
  "p08-convex-domain": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "二阶连续可微和凸域使逐条线段的非负二阶曲率与凸性等价。",
      "B": "初始点的曲率不限制其他位置，无法推出全域凸性。",
      "C": "凸函数满足f(y)≥f(x)+∇f(x)ᵀ(y−x)，驻点将右端化为f(x)。",
      "D": "严格凸排除两个不同点同时最小，但最小值是否取得还需另查。"
    }
  },
