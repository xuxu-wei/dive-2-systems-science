  },
  "p08-newton-taylor": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "对p求导得到g+Hp，置零即得牛顿方程。",
      "B": "一般目标还有高阶余项，局部模型的全步可能过远，仍需检查实际目标。",
      "C": "正定性使非零p的二次型为正，乘牛顿方程得到负方向导数。",
      "D": "二次目标的展开准确等于原函数，所以H(x+p)=b直接给出最小点。"
    }
  },
  "p08-negative-curvature": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "当前点与方向固定时，缩小正步长不会改变g·p的符号。",
      "B": "本例g=−0.192，原p约−0.2182；负梯度0.192给出负的方向导数。",
      "C": "改变检验公式不改变目标沿原方向的一阶上升，不能代替方向修正。",
      "D": "正比例归一化保持原来的上升方向，且实际全步仍未经下降检验。"
    }
  },
  "p08-stationary-stop": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "f′(0)=0，算法确实识别了一个驻点。",
      "B": "f″(0)=−1，向两侧小幅移动都会降低目标，原点是严格局部最大点。",
      "C": "负二阶导数提供了局部最大点的判断，一阶停止条件没有这项信息。",
      "D": "该停止规则无法区分最小与最大驻点，原点正是反例。"
    }
  },
