  "p08-trial-budget": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "没有执行任何步长检验，因此没有接受值，应按有限回溯失败返回。",
      "B": "初始步长也要经过检验，零次尝试没有检验它。",
      "C": "尝试次数为零不说明梯度或其他停止条件已经达标。",
      "D": "规则只接受通过检验的正候选步长，零步长没有满足这个过程。"
    }
  },
  "p08-line-search-status": {
    "correct": [
      "B",
      "C",
      "D"
    ],
    "explanations": {
      "A": "接受检查下降量，收敛检查最后残差等条件，两者并不相同。",
      "B": "接受值满足f(x+tp)≤f(x)+ctgᵀp，这是本次比较的结论。",
      "C": "新点得到后需重新计算残差，才能判断外层是否继续。",
      "D": "退出原因应反映真实条件，不能把次数用完改写成converged。"
    }
  },
  "p08-objective-offset": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "减常数会改变目标是否为负，即使当前点与最优距离没有变化。",
      "B": "常数的导数为零，梯度范数与阈值比较完全相同。",
      "C": "加减常数保留最小点，因此当前点到该点的距离相同。",
      "D": "目标平移改变绝对值，可能在同一位置给出不同停止判断。"
    }
  },
  "p08-search-guarantee": {
    "correct": [
      "A",
      "C"
    ],
    "explanations": {
      "A": "一阶负变化超过高阶余项时，就满足所要求的一部分下降。",
      "B": "局部形状决定所需步长，20次缩小未必达到该范围。",
      "C": "由f(x+tp)=f(x)+tgᵀp+o(t)，而(c−1)gᵀp>0，余项足够小时可以被正余量覆盖。",
      "D": "非零方向可能上升或一阶变化为零，无法沿用严格下降的证明。"
    }
  },
