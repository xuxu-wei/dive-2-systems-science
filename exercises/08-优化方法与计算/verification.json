          ],
          "direction": [
            1.0
          ],
          "initial_step": 1.0,
          "shrink": 0.5,
          "slope": 0.1,
          "max_trials": 5
        },
        "expected": [
          [
            1.0
          ],
          null,
          "not_descent"
