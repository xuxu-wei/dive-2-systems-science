  "p08-step-limit": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "两个方向的误差因子为1−η与1−10η，都要求绝对值小于1，合并得到0<η<0.2。",
      "B": "η=0.2时第二方向因子为−1，非零误差等幅交替而不趋于零。",
      "C": "这个范围只考虑了第一方向，第二方向会先失稳。",
      "D": "它是足够范围的一部分，但漏掉仍可收敛的步长，例如0.15。"
    }
  },
  "p08-conditioning": {
    "correct": [
      "A",
      "B",
      "D"
    ],
    "explanations": {
      "A": "较小特征值为1，所以误差因子是1−0.01×1=0.99。",
      "B": "较大曲率方向的误差因子是1−100η；若要求它严格衰减，范围是0<η<0.02。",
      "C": "正定二次目标的条件数是最大特征值与最小特征值之比，比较两个方向。",
      "D": "更新中的ηH与ηb同时保持不变，因此整个递推和起点相同。"
    }
  },
  "p08-small-gradient": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "最小点是[0,0]，距离由[1,0]计算，等于1。",
      "B": "弱曲率使梯度很小；本例距离应由0.001除以0.001得到1。",
      "C": "g=H(x−x*)，而正定H满足‖He‖≥μ‖e‖。",
      "D": "坐标缩放会改变梯度分量及其范数，相同数值阈值不一定代表相同精度。"
    }
  },
