  "p08-ridge-normalization": {
    "correct": [
      "D"
    ],
    "explanations": {
      "A": "把缩放方向写反；新数据项放大n倍，惩罚也应放大n倍。",
      "B": "惩罚多放大一倍n，改变正则化（regularization）强度。",
      "C": "仅数据项放大n倍会改变与惩罚的相对权重。",
      "D": "新目标等于旧目标乘n，故最小点集合相同。"
    }
  },
  "p08-rank-and-ridge": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "XᵀX/n半正定（positive semidefinite），加λI后正定。",
      "B": "同样的预测仍可由多个无惩罚系数组（array）成。",
      "C": "不要把正则选择解释为可辨识性（identifiability）。",
      "D": "二范数（norm）惩罚主要连续收缩。"
    }
  },
  "p08-penalty-intercept": {
    "correct": [
      "A",
      "C"
    ],
    "explanations": {
      "A": "不同角色应在目标中说明。",
      "B": "截距保存原响应均值，改变响应单位会改变其数值。",
      "C": "这是明确的建模选择。",
      "D": "截距与斜率在该目标中的角色不同，斜率惩罚仍控制模型（model）复杂度。"
    }
  },
