  },
  "p08-trial-budget": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "预算为0，没有任何已通过检验的步长。",
      "B": "没有执行检验，初始候选不能视为已接受。",
      "C": "未尝试步长不代表满足收敛条件。",
      "D": "零步长未经有效下降检验，不能冒充接受一次更新。"
    }
  },
  "p08-line-search-status": {
    "correct": [
      "B",
      "C",
      "D"
    ],
    "explanations": {
      "A": "充分下降与驻点（stationary point）容差是不同条件，题设新梯度仍非零。",
      "B": "条件仅比较两个点。",
      "C": "停止需要独立标准。",
      "D": "不能把退出循环都写成converged。"
    }
  },
  "p08-objective-offset": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "添加常数会使该判断失效。",
      "B": "梯度不受常数影响。",
      "C": "最小点不变。",
      "D": "平移目标会改变|f|，即使梯度和最小点完全不变。"
    }
  },
  "p08-search-guarantee": {
    "correct": [
      "A",
      "C"
    ],
    "explanations": {
      "A": "负方向导数（derivative）提供严格余量。",
      "B": "所需小步长度取决于局部函数形状，固定20次不提供普遍保证。",
      "C": "f(x+tp)=f(x)+tgᵀp+o(t)。",
      "D": "非零方向可能上升或一阶为零，不能用负方向导数的论证。"
    }
  },
