  "p08-loss-units": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "每个比值无量纲，尺度的来源须说明。",
      "B": "除以样本数只改变平均方式，平方残差仍保留不同单位。",
      "C": "相对权重改变目标的折中。",
      "D": "正比例不改变目标值的次序。"
    }
  },
  "p08-gradient-direction": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "方向导数（derivative）gᵀp=0，不能保证一阶变化为负。",
      "B": "方向导数为‖g‖²>0。",
      "C": "方向导数为−‖g‖²<0。",
      "D": "方向导数仍为正，一阶变化上升。"
    }
  },
  "p08-change-coordinates": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "H因D对角而可这样写，但线性项还需b改为Dᵀb。",
      "B": "代入原二次式即可得到。",
      "C": "否则可行点或起点发生变化。",
      "D": "可行点也需满足x=Dz，边界值应按对应尺度换算。"
    }
  },
  "p08-linear-minimum": {
    "cases": [
      {
        "arguments": {
          "matrix": [
            [
              2.0,
              0.0
            ],
            [
              0.0,
              4.0
            ]
          ],
          "linear": [
            2.0,
            8.0
          ]
        },
        "expected": [
          1.0,
          2.0
        ]
      },
      {
        "arguments": {
          "matrix": [
            [
              2.0,
              1.0
            ],
            [
              1.0,
              2.0
            ]
          ],
          "linear": [
            3.0,
            0.0
          ]
        },
        "expected": [
          2.0,
          -1.0
        ]
      },
      {
        "arguments": {
          "matrix": [
            [
              0.2,
              0.0
            ],
            [
              0.0,
              10.0
            ]
          ],
          "linear": [
            0.0,
            -2.0
          ]
        },
        "expected": [
          0.0,
          -0.2
        ]
      }
    ],
    "explanation": "两个坐标分别为2/2和8/4，即[1,2]。"
  },
  "p08-stationary-counterexample": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "驻点（stationary point）只是一阶必要条件；0处二阶导数−1对应局部最大。",
      "B": "负曲率说明向两侧小幅移动都会下降。",
      "C": "可写成(x²−1)²/4−1/4。",
      "D": "负二阶导数只给局部最大；f(x)随|x|增大趋于正无穷。"
    }
  },
  "p08-hessian-zero": {
    "correct": [
      "B",
      "C",
      "D"
    ],
    "explanations": {
      "A": "等于0时二阶判别不确定，f₂=−x⁴在0实际为极大。",
      "B": "x⁴≥0且仅在0等号。",
      "C": "−x⁴≤0且仅在0等号。",
      "D": "f₂就是反例，须看邻域或更高阶。"
    }
  },
  "p08-convex-domain": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "沿每条线段的二阶导数（second derivative）非负。",
      "B": "局部曲率不能覆盖整个域。",
      "C": "一阶支撑不等式给出全域下界。",
      "D": "严格凸排除两个不同最小点；存在性另需条件。"
    }
  },
